---
import InteriorLayout from '../layouts/InteriorLayout.astro';
import { site, credentials, chatHref, assistant } from '../data/site';
import photo from '../assets/photos/kitchen-f.jpg';
import { reviews, googleReviews } from '../data/reviews';
// A bid handled straight is what a visitor about to ask for one wants to read.
const quote = reviews.peyton;
---
<InteriorLayout title="Contact a DC Remodeling Contractor | I.S Design + Build" description={`Talk to I.S Design + Build about your remodeling or roofing project. Call ${site.phone}, chat with us at any time, or email ${site.email}.`} label="Contact" headline="Tell us about your project." image={photo} photo="photos/kitchen-f" compact>
  <Fragment slot="intro"><p>Call us, or start a chat at any time. Either way, tell us about the house and what you want to change.</p><div class="hero-actions"><a class="btn" href={chatHref()} data-chat>Chat now</a><a class="text-link" href={site.phoneHref}>Call {site.phone}</a></div></Fragment>
  <section class="enquiry">
    <aside class="enquiry-proof" aria-label="About I.S Design + Build" data-reveal style="--d:120ms">
      <p class="enquiry-rating"><span aria-hidden="true">★★★★★</span><b>{googleReviews.rating}</b> on Google from {googleReviews.count} reviews</p>
      <blockquote class="enquiry-review"><p>“{quote.text}”</p><footer>{quote.name}, {quote.job}, Google review, {quote.date}</footer><a class="text-link" href="/reviews/">Read more reviews</a></blockquote>
      <p class="enquiry-since"><b>{site.since}</b><span>In business in the DC area since {site.since}.</span></p>
      {credentials && <p class="enquiry-credentials">{credentials}</p>}
      <address class="enquiry-office">{site.address[0]}<br />{site.address[1]}<br />{site.hours}</address>
    </aside>
    <div class="enquiry-main" data-reveal>
      <ul class="contact-ways" aria-label="Ways to reach us">
        <li>
          <span>Chat</span>
          <a href={chatHref()} data-chat>Chat now</a>
          <p>{assistant}, our AI assistant, answers at any time. Tell {assistant} about the project and how to reach you, and our team follows up.</p>
          <p class="contact-failed" data-chat-failed hidden tabindex="-1" role="status">The chat couldn’t open in this browser. It may be blocked by a privacy setting or an ad blocker. Please call or email us instead.</p>
        </li>
        <li>
          <span>Call</span>
          <a href={site.phoneHref}>{site.phone}</a>
          <p>{site.hours}. For a roof leak, call. It’s the fastest way to reach us.</p>
        </li>
        <li>
          <span>Email</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <p>Photos of the space or the problem are welcome.</p>
        </li>
      </ul>
      <ol class="next-steps" aria-label="What happens next">
        <li><b>01</b><span>You tell us about the house and what you want to change.</span></li>
        <li><b>02</b><span>We get back to you to talk it through.</span></li>
        <li><b>03</b><span>If it’s a fit, we visit the house and prepare the scope and estimate.</span></li>
      </ol>
      <p class="form-note">Useful before you get in touch: <a href="/our-process/">how we work</a>, <a href="/financing/">financing</a> and <a href="/faqs/">common questions</a>.</p>
    </div>
  </section>
</InteriorLayout>
