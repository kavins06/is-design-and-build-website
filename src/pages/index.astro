---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/hero.css';
import '../styles/home.css';
import '../styles/content.css';
import '../styles/interior.css';
import '../styles/scenes.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Cta from '../components/Cta.astro';
import { site, capabilities, process } from '../data/site';
import { photos } from '../data/photos';
import stockRowhouses from '../assets/stock/town-05.jpg';
import Reviews from '../components/Reviews.astro';
import { googleReviews } from '../data/reviews';

const statement = 'One team designs it, prices it and builds it.'.split(' ');

// One company photograph per service, in the order of `capabilities`: the photograph that
// service's own page opens on, so the visitor lands where the picture promised.
const capImg = ['kitchen-d', 'bath-b', 'kitchen-c', 'deck-a', 'roof-b'].map((key) => photos[key].src);
// Lead paint has no project photograph yet: a labelled stock street of older rowhouses stands in.
capImg.push(stockRowhouses);
const stockCap = capImg.length - 1;
// The finished room the process plan opens onto, and the photograph under the closing band.
const processPhoto = photos['kitchen-b'];
const bandPhoto = photos['roof-a'];

// More finished rooms, none of them shown elsewhere on this page.
const rooms = ['bath-a', 'kitchen-f', 'powder-c', 'roof-c', 'bed-a', 'powder-b'].map((key) => {
  const p = photos[key];
  return { src: p.src, name: p.room, alt: p.alt, tall: !!p.tall };
});
const facts = [
  { n: googleReviews.rating, label: `On Google, from ${googleReviews.count} reviews` },
  { n: site.since, label: 'In business since' },
  { n: new Date().getFullYear() - site.since, label: 'Years in business' },
];

// Floor plan drawn in the process section. Each group belongs to one stage.
const bubbles = [
  { cx: 195, cy: 155, rx: 112, ry: 82 },
  { cx: 195, cy: 368, rx: 112, ry: 82 },
  { cx: 465, cy: 260, rx: 112, ry: 172 },
  { cx: 670, cy: 195, rx: 56, ry: 118 },
  { cx: 670, cy: 405, rx: 52, ry: 52 },
];
const labels = [
  { x: 195, y: 124, t: 'Kitchen' },
  { x: 195, y: 300, t: 'Dining' },
  { x: 465, y: 215, t: 'Living' },
  { x: 670, y: 186, t: 'Bath' },
  { x: 670, y: 440, t: 'Entry' },
];
const walls = [
  'M60 50H740V470H700M640 470H60V50',
  'M60 260H250',
  'M330 50V150M330 370V470',
  'M600 50V200H740M600 240V340H740M600 340V400',
];
const openings = [
  'M640 470a60 60 0 0 1 60 -60V470',
  'M600 240a40 40 0 0 0 -40 -40H600',
  'M120 44H270M120 56H270M390 44H540M390 56H540',
  'M54 320V410M66 320V410',
  'M610 214H730M610 228H730M610 242H730M610 256H730M610 270H730M610 284H730M610 298H730M610 312H730M610 326H730',
];
const dimLines = ['M60 22H740M60 12v20M740 12v20', 'M32 50V470M22 50h20M22 470h20'];
const fittings = [
  'M72 62H318V100H112V248H72z',
  'M180 68h44v24h-44zM262 74a8 8 0 1 0 0.1 0M290 74a8 8 0 1 0 0.1 0',
  'M150 142H290V200H150z',
  'M170 212a10 10 0 1 0 0.1 0M220 212a10 10 0 1 0 0.1 0M270 212a10 10 0 1 0 0.1 0',
  'M120 322H270V408H120zM140 304h30v12h-30zM220 304h30v12h-30zM140 414h30v12h-30zM220 414h30v12h-30z',
  'M420 58H510V76H420z',
  'M370 384H560V440H370zM370 384V370H560V384',
  'M420 290H530V340H420z',
  'M612 62H728V112H612zM640 148a14 14 0 1 0 0.1 0M678 132H728V192H678z',
];
---

<BaseLayout preloadFonts title="Home Remodeling & Roofing in DC | I.S Design + Build" description="Kitchens, bathrooms, additions, whole-home renovations and roofing from an in-house team serving DC, Maryland and Northern Virginia.">
  <div class="cg">
    <Header home />
    <main id="main" tabindex="-1">
      <Hero />
      <div class="proof-line"><a href={googleReviews.url} rel="noopener"><span class="proof-stars" aria-hidden="true">★</span>{googleReviews.rating} on Google<span class="proof-read">&nbsp;· {googleReviews.count} reviews</span></a><span>In business since {site.since}</span><span>Founded by Italo Rodriguez and Eddie Migues</span><a href="/reviews/">Read the reviews</a></div>

      <section class="ex" id="expertise">
        <div class="ex-media">
          {capImg.map((img, i) => <Image src={img} alt="" widths={[700, 1200]} sizes="(min-width: 900px) 42vw, 92vw" loading="lazy" class={i === 0 ? 'is-on' : ''} data-cap={i} data-stock={i === stockCap ? '' : undefined} />)}
          <span class="ex-count"><b>01</b> / 0{capabilities.length}</span>
          <span class="media-note">Stock image</span>
        </div>
        <div class="ex-list">
          <p class="cg-label">Remodeling, roofing & lead paint</p><h2>What we build.</h2>
          <ol>
            {
              capabilities.map((c, i) => (
                <li class={i === 0 ? 'is-on' : ''} data-cap-item={i}>
                  <a href={c.href}>
                    <Image src={capImg[i]} alt="" widths={[500, 900]} sizes="92vw" loading="lazy" class="ex-thumb" />
                    {i === stockCap && <span class="media-note ex-thumb-note">Stock image</span>}
                    <span>{c.n}</span>
                    <div>
                      <h3>{c.name}</h3>
                      <p>{c.text}</p>
                    </div>
                  </a>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="rm" id="rooms">
        <div class="rm-pin">
          <div class="rm-head">
            <p class="cg-label">From our completed work</p><a href="/portfolio/">View our projects</a>
            <p class="rm-hint">Keep scrolling</p>
          </div>
          <div class="rm-track">
            <h2 class="rm-title">Rooms<br />we’ve built.</h2>
            {
              rooms.map((r, i) => (
                <figure class={r.tall ? 'is-tall' : ''}>
                  <a href="/portfolio/"><div><Image src={r.src} alt={r.alt} widths={[700, 1200, 1600]} sizes="(min-width: 900px) 50vw, 80vw" /></div>
                  <figcaption><span>0{i + 1}</span>{r.name}</figcaption></a>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <section class="st" id="firm">
        <p class="cg-label">How we work</p>
        <h2 class="st-text" aria-label={statement.join(' ')}>
          {statement.map((w) => <span aria-hidden="true">{w} </span>)}
        </h2>
        <div class="st-description"><p>We agree the scope and the estimate with you before anything is built, so the price matches the work.</p><a class="text-link" href="/our-process/">See how a project runs</a></div>
      </section>

      <section class="pr" id="process" data-dark>
        <div class="pr-pin">
          <div class="pr-side">
            <p class="cg-label">A clear way forward</p>
            <ol class="pr-steps">
              {
                process.map((p, i) => (
                  <li class={i === 0 ? 'is-on' : ''}>
                    <span>{p.n}</span>
                    <div>
                      <h3>{p.name}</h3>
                      <p>{p.text}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
            <p class="pr-detail" aria-hidden="true">{process[0].text}</p>
            <div class="pr-progress"><i></i></div><a class="text-link" href="/our-process/">See our process</a>
          </div>

          <figure class="pr-sheet">
            <svg viewBox="0 0 800 520" role="img" aria-label="A floor plan that develops from a sketch to a finished home as you scroll">
              <g class="pl-bubbles">
                {bubbles.map((b) => <path d={`M${b.cx - b.rx} ${b.cy}a${b.rx} ${b.ry} 0 1 0 ${2 * b.rx} 0a${b.rx} ${b.ry} 0 1 0 ${-2 * b.rx} 0`} pathLength="1" class="draw" />)}
              </g>
              <g class="pl-labels">
                {labels.map((l) => <text x={l.x} y={l.y} text-anchor="middle">{l.t}</text>)}
              </g>
              <g class="pl-walls">{walls.map((d) => <path d={d} pathLength="1" class="draw" />)}</g>
              <g class="pl-openings">{openings.map((d) => <path d={d} pathLength="1" class="draw" />)}</g>
              <g class="pl-dims">
                {dimLines.map((d) => <path d={d} pathLength="1" class="draw" />)}
                <text x="400" y="14" text-anchor="middle">34'-0"</text>
                <text x="24" y="264" text-anchor="middle" transform="rotate(-90 24 264)">21'-0"</text>
              </g>
              <g class="pl-stamp" transform="translate(470 250) rotate(-10)">
                <rect x="-112" y="-34" width="224" height="68"></rect>
                <text y="-4" text-anchor="middle">SCOPE + PLANNING</text>
                <text y="18" text-anchor="middle" class="pl-stamp-sub">PROJECT REVIEW</text>
              </g>
              <g class="pl-fittings">{fittings.map((d) => <path d={d} pathLength="1" class="draw" />)}</g>
            </svg>
            <Image src={processPhoto.src} alt={processPhoto.alt} widths={[800, 1400]} sizes="(min-width: 900px) 56vw, 92vw" class="pr-photo" />
            <figcaption>
              <span>Illustrative plan</span>
              <span class="pr-stage">Sketch</span>
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="bd" data-dark>
        <div class="bd-frame">
          <Image src={bandPhoto.src} alt={bandPhoto.alt} widths={[800, 1400, 2000, 2560]} sizes="100vw" loading="lazy" class="bd-photo" />
          <h2>From the kitchen<br />to the roof.</h2>
          <span class="media-note bd-note">Our project</span>
        </div>
      </section>

      <section class="fc">
        {
          facts.map((f) => (
            <div>
              <b>{f.n}</b>
              <span>{f.label}</span>
            </div>
          ))
        }
      </section>

      <Reviews keys={['dean', 'solerPrice']} label="Clients" />

      <Cta />
    </main>
    <Footer />
  </div>
</BaseLayout>

<script>
  import '../scripts/media.ts';
  // Keep the static reduced-motion experience free of animation dependencies.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    import('../scripts/home.ts');
  }
</script>
