---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import InteriorLayout from '../layouts/InteriorLayout.astro';
import Cta from '../components/Cta.astro';
import PlanStory from '../components/scenes/PlanStory.astro';
import Band from '../components/scenes/Band.astro';
import Rail from '../components/scenes/Rail.astro';
import Steps from '../components/scenes/Steps.astro';
import Span from '../components/scenes/Span.astro';
import Panels from '../components/scenes/Panels.astro';
import Portfolio from '../components/scenes/Portfolio.astro';
import Reviews from '../components/Reviews.astro';
import pages from '../data/content.json';
import { site } from '../data/site';
import { service, faqPage } from '../data/schema';
export function getStaticPaths() { return pages.map(page => ({ params: { slug: page.slug }, props: { page } })); }
const { page } = Astro.props as { page: any };
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/{photos,stock}/*.jpg', { eager: true });
const img = (name: string) => images[`../assets/${name}.jpg`].default;
const path = `/${page.slug}/`;
const sheet = `A-${String(pages.findIndex((p) => p.slug === page.slug) + 1).padStart(2, '0')}`;
const schema: object[] = [];
const serviceNames: Record<string, string> = {
  'home-remodeling': 'Home remodeling',
  'kitchen-remodeling': 'Kitchen remodeling',
  'bathroom-remodeling': 'Bathroom remodeling',
  'whole-home-remodeling': 'Whole-home renovation',
  'home-additions': 'Home additions',
  roofing: 'Roof repair and replacement',
};
if (serviceNames[page.slug]) schema.push(service(serviceNames[page.slug], page.description, path));
// Questions are taken from the visible copy so the markup always matches the page.
const questions = page.sections.filter((s: any) => s.kind === 'faq').flatMap((s: any) => s.items).map((it: any) => ({ q: it.q, a: it.link ? `${it.a} ${it.link.text}` : it.a }));
if (questions.length) schema.push(faqPage(questions));
const external = (href: string) => /^https?:/.test(href);
// The first photograph-and-statement section on a page opens full bleed; any later one sits beside its text.
const firstSplit = page.sections.findIndex((s: any) => s.kind === 'split');
---
<InteriorLayout title={page.title} description={page.description} label={page.label} headline={page.headline} schema={schema} image={page.image ? img(page.image) : undefined} photo={page.image ?? undefined} sheet={sheet}>
  <Fragment slot="intro">
    <p>{page.lede}</p>
    {page.phone
      ? <div class="hero-actions"><a class="btn" href={site.phoneHref}>Call {site.phone}</a><a class="text-link" href={page.ctaHref ?? `/contact-us/?service=${page.service}`}>{page.cta}</a></div>
      : <div class="hero-actions"><a class="btn" href={`/contact-us/?service=${page.service || 'other'}`}>{page.cta}</a><a class="text-link" href={site.phoneHref}>Call {site.phone}</a></div>}
  </Fragment>
  {page.sections.map((s: any, index: number) => (
    <>
      {s.kind === 'points' && s.drawing && <PlanStory label={s.label} title={s.title} items={s.items} drawing={s.drawing} note={s.note} />}
      {s.kind === 'points' && !s.drawing && (
        <section class="pts" data-dark>
          <div class="pts-head"><p class="cg-label">{s.label}</p><h2 data-split>{s.title}</h2></div>
          <ol class:list={['pts-grid', `n${s.items.length}`]}>
            {s.items.map((it: any, i: number) => (
              <li data-reveal style={`--d:${i * 90}ms`}>
                <span>{String(i + 1).padStart(2, '0')}</span>
                <h3>{it.name}</h3>
                <p>{it.text}</p>
                {it.href && <a class="text-link" href={it.href} rel={external(it.href) ? 'noopener' : undefined}>{it.cta}</a>}
              </li>
            ))}
          </ol>
          {s.note && <p class="pts-note">{s.note}</p>}
        </section>
      )}
      {s.kind === 'split' && index === firstSplit && <Band label={s.label} title={s.title} text={s.text} image={img(s.image)} alt={s.alt} stock={s.image.startsWith('stock/')} link={s.link} />}
      {s.kind === 'split' && index !== firstSplit && (
        <section class="sp" data-scene="split">
          <figure><Image src={img(s.image)} alt={s.alt} widths={[700, 1200, 1800]} sizes="(min-width: 900px) 52vw, 92vw" />{s.image.startsWith('stock/') && <span class="media-note">Stock image</span>}</figure>
          <div class="sp-copy">
            <p class="cg-label">{s.label}</p>
            <h2 data-split>{s.title}</h2>
            {s.text.map((t: string) => <p data-reveal>{t}</p>)}
            {s.link && <a class="text-link" data-reveal href={s.link.href} rel={external(s.link.href) ? 'noopener' : undefined}>{s.link.text}</a>}
          </div>
        </section>
      )}
      {s.kind === 'services' && <Panels label={s.label} title={s.title} />}
      {s.kind === 'steps' && <Steps items={s.items} />}
      {s.kind === 'facts' && <Span />}
      {s.kind === 'reviews' && <Reviews keys={s.keys} label={s.label} title={s.title} dark={s.dark} />}
      {s.kind === 'statement' && (
        <section class="stmt">
          <p class="cg-label">{s.label}</p>
          <div class="stmt-body">
            <h2 data-split>{s.title}</h2>
            {s.text?.map((t: string) => <p data-reveal>{t}</p>)}
            {s.link && <a class="text-link" data-reveal href={s.link.href} rel={external(s.link.href) ? 'noopener' : undefined}>{s.link.text}</a>}
          </div>
        </section>
      )}
      {s.kind === 'gallery' && (s.category ? <Rail gallery={s.category} title={s.title} /> : <Portfolio />)}
      {s.kind === 'faq' && (
        <section class="fq">
          <div class="fq-head"><p class="cg-label">Questions</p><h2 data-split>{s.title}</h2></div>
          <div class="fq-list">
            {s.items.map((it: any, i: number) => <details open={s.open && i === 0}><summary>{it.q}</summary><p>{it.a}{it.link && <> <a href={it.link.href}>{it.link.text}</a></>}</p></details>)}
          </div>
        </section>
      )}
    </>
  ))}
  <Cta service={page.service} lines={page.closing} phone={page.phone} />
</InteriorLayout>
