---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import InteriorLayout from '../layouts/InteriorLayout.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import Cta from '../components/Cta.astro';
import pages from '../data/content.json';
import { site, capabilities } from '../data/site';
import { service, faqPage } from '../data/schema';
export function getStaticPaths() { return pages.map(page => ({ params: { slug: page.slug }, props: { page } })); }
const { page } = Astro.props as { page: any };
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/{photos,stock}/*.jpg', { eager: true });
const img = (name: string) => images[`../assets/${name}.jpg`].default;
const path = `/${page.slug}/`;
const schema: object[] = [];
const serviceNames: Record<string, string> = {
  'home-remodeling': 'Home remodeling',
  'kitchen-remodeling': 'Kitchen remodeling',
  'bathroom-remodeling': 'Bathroom remodeling',
  'whole-home-remodeling': 'Whole-home renovation',
  'home-additions': 'Home additions',
  roofing: 'Roof repair and replacement',
};
if (serviceNames[page.slug]) schema.push(service(serviceNames[page.slug], page.description, path));
// Questions are taken from the visible copy so the markup always matches the page.
const questions = page.sections.filter((s: any) => s.kind === 'faq').flatMap((s: any) => s.items);
if (questions.length) schema.push(faqPage(questions));
const serviceImg: Record<string, string> = { kitchen: 'photos/kitchen-a', bathroom: 'photos/bath-a', 'whole-home': 'stock/home-10', addition: 'photos/exterior-a', roofing: 'stock/town-12' };
const years = new Date().getFullYear() - site.since;
const external = (href: string) => /^https?:/.test(href);
---
<InteriorLayout title={page.title} description={page.description} label={page.label} headline={page.headline} schema={schema} image={img(page.image)}>
  <Fragment slot="intro">
    <p>{page.lede}</p>
    <div class="hero-actions"><a class="btn" href={`/contact-us/?service=${page.service || 'other'}`}>{page.cta}</a><a class="text-link" href={site.phoneHref}>Call {site.phone}</a></div>
  </Fragment>
  {page.sections.map((s: any) => (
    <>
      {s.kind === 'points' && (
        <section class="pts" data-dark>
          <div class="pts-head" data-reveal><p class="cg-label">{s.label}</p><h2>{s.title}</h2></div>
          <ol class:list={['pts-grid', `n${s.items.length}`]}>
            {s.items.map((it: any, i: number) => (
              <li data-reveal style={`--d:${i * 90}ms`}>
                <span>{String(i + 1).padStart(2, '0')}</span>
                <h3>{it.name}</h3>
                <p>{it.text}</p>
                {it.href && <a class="text-link" href={it.href} rel={external(it.href) ? 'noopener' : undefined}>{it.cta}</a>}
              </li>
            ))}
          </ol>
          {s.note && <p class="pts-note">{s.note}</p>}
        </section>
      )}
      {s.kind === 'split' && (
        <section class="sp">
          <figure data-reveal><Image src={img(s.image)} alt={s.alt} widths={[700, 1200, 1800]} sizes="(min-width: 900px) 52vw, 92vw" /></figure>
          <div class="sp-copy" data-reveal>
            <p class="cg-label">{s.label}</p>
            <h2>{s.title}</h2>
            {s.text.map((t: string) => <p>{t}</p>)}
            {s.link && <a class="text-link" href={s.link.href} rel={external(s.link.href) ? 'noopener' : undefined}>{s.link.text}</a>}
          </div>
        </section>
      )}
      {s.kind === 'services' && (
        <section class="sv">
          <div class="sv-head" data-reveal><p class="cg-label">{s.label}</p><h2>{s.title}</h2></div>
          <div class="sv-grid">
            {capabilities.filter(c => c.service !== 'roofing').map((c, i) => (
              <a href={c.href} data-reveal style={`--d:${i * 90}ms`}>
                <Image src={img(serviceImg[c.service])} alt="" widths={[500, 900]} sizes="(min-width: 900px) 24vw, 92vw" />
                <span>{c.n}</span><h3>{c.name}</h3>
              </a>
            ))}
          </div>
        </section>
      )}
      {s.kind === 'steps' && (
        <section class="stp" data-dark>
          <ol>
            {s.items.map((it: any, i: number) => (
              <li data-reveal><span>{String(i + 1).padStart(2, '0')}</span><h2>{it.name}</h2><p>{it.text}</p></li>
            ))}
          </ol>
        </section>
      )}
      {s.kind === 'facts' && (
        <section class="fc">
          <div><b>{site.since}</b><span>Building since</span></div>
          <div><b>{years}</b><span>Years of experience</span></div>
          <div><b class="fact-word">In-house</b><span>One team, start to finish</span></div>
          <div><b class="fact-word">3 areas</b><span>DC, Northern Virginia, Montgomery County</span></div>
        </section>
      )}
      {s.kind === 'quote' && (
        <section class="rv"><p class="cg-label">Clients</p><blockquote data-reveal><p>“{s.text}”</p><footer>{s.by}</footer><a class="text-link" href="https://maps.google.com/maps?cid=1968106805018591346" rel="noopener">Read our Google reviews</a></blockquote></section>
      )}
      {s.kind === 'gallery' && <ProjectGallery compact={!!s.category} category={s.category} />}
      {s.kind === 'faq' && (
        <section class="fq">
          <div class="fq-head"><p class="cg-label">Questions</p><h2>{s.title}</h2></div>
          <div class="fq-list">
            {s.items.map((it: any, i: number) => <details open={s.open && i === 0}><summary>{it.q}</summary><p>{it.a}</p></details>)}
          </div>
        </section>
      )}
    </>
  ))}
  <Cta service={page.service} />
</InteriorLayout>
