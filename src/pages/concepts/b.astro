---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/hanken-grotesk';
import { Image } from 'astro:assets';
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import { site, sectors, capabilities, process } from '../../data/site';
import heroTall from '../../assets/photos/bath-tall.jpg';
import heroWide from '../../assets/photos/kitchen-b.jpg';
import res from '../../assets/photos/living-a.jpg';
import com from '../../assets/photos/deck-a.jpg';
import gov from '../../assets/photos/roof-a.jpg';
import g1 from '../../assets/photos/kitchen-a.jpg';
import g2 from '../../assets/photos/shower-tall.jpg';
import g3 from '../../assets/photos/bath-b.jpg';
import g4 from '../../assets/photos/bed-a.jpg';
import g5 from '../../assets/photos/kitchen-c.jpg';

const sectorImg = { residential: res, commercial: com, government: gov } as const;
const gallery = [
  { src: g1, alt: 'Kitchen with timber cabinetry and island seating', tall: false },
  { src: g2, alt: 'Glass shower enclosure in pale stone', tall: true },
  { src: g3, alt: 'Marble bathroom with floating vanity', tall: false },
  { src: g4, alt: 'Bedroom opening to a terrace', tall: false },
  { src: g5, alt: 'Kitchen island beside an open stair', tall: false },
];
---

<ConceptLayout title="Direction B · Atelier — I.S Design + Build" current="b">
  <div class="cb">
    <header class="cb-head">
      <nav aria-label="Primary">
        <a href="#sectors">Residential</a>
        <a href="#sectors">Commercial</a>
        <a href="#sectors">Government</a>
      </nav>
      <a class="cb-logo" href="/concepts/b/" aria-label={site.name}>
        <span class="cb-logo-is">I.S</span>
        <span class="cb-logo-sub">Design <i>+</i> Build</span>
      </a>
      <nav aria-label="Secondary">
        <a href="#work">Work</a>
        <a href="#practice">Practice</a>
        <a class="cb-link" href="#start">Start a project</a>
      </nav>
    </header>

    <section class="cb-hero">
      <div class="cb-hero-copy">
        <p class="cb-eyebrow">General contractor · Washington, DC · Since {site.since}</p>
        <h1>
          Buildings, <em>considered</em> from the first sketch to the last coat of paint.
        </h1>
        <p class="cb-lede">
          I.S Design + Build designs and builds homes, commercial interiors and public spaces. One studio, one crew, one
          contract.
        </p>
        <a class="cb-btn" href="#start"><span>Begin a conversation</span></a>
      </div>
      <div class="cb-hero-art">
        <figure class="cb-hero-tall">
          <Image src={heroTall} alt="Bathroom with stone-clad shower and matte black fixtures" widths={[500, 900]} sizes="(min-width: 900px) 30vw, 70vw" loading="eager" />
        </figure>
        <figure class="cb-hero-wide">
          <Image src={heroWide} alt="Kitchen with a long island and pendant lighting" widths={[500, 900]} sizes="(min-width: 900px) 26vw, 60vw" loading="eager" />
          <figcaption>Girard Street NE — kitchen</figcaption>
        </figure>
      </div>
    </section>

    <section class="cb-note" id="practice">
      <p class="cb-num">N° 01 — The practice</p>
      <p class="cb-note-text" data-reveal>
        We have been building in Washington since {site.since}. The work ranges from a single bathroom to an entire building,
        and the method does not change: <em>design it properly, price it honestly, build it once.</em>
      </p>
    </section>

    <section class="cb-sectors" id="sectors">
      <p class="cb-num">N° 02 — Who we build for</p>
      {
        sectors.map((s, i) => (
          <a class="cb-sector" href="#start" data-reveal>
            <span class="cb-sector-n">{String(i + 1).padStart(2, '0')}</span>
            <h2>{s.name}</h2>
            <p>
              <b>{s.line}</b> {s.text}
            </p>
            <figure>
              <Image src={sectorImg[s.slug as keyof typeof sectorImg]} alt="" widths={[400, 700]} sizes="(min-width: 900px) 22vw, 90vw" />
            </figure>
          </a>
        ))
      }
    </section>

    <section class="cb-gallery" id="work">
      <div class="cb-gallery-head">
        <p class="cb-num">N° 03 — Selected work</p>
        <p>Drag or scroll →</p>
      </div>
      <div class="cb-gallery-track">
        {
          gallery.map((g) => (
            <figure class={g.tall ? 'is-tall' : ''}>
              <Image src={g.src} alt={g.alt} widths={[600, 1000]} sizes="(min-width: 900px) 42vw, 80vw" />
            </figure>
          ))
        }
      </div>
    </section>

    <section class="cb-caps">
      <div>
        <p class="cb-num">N° 04 — What we do</p>
        <h2>An index of the work.</h2>
      </div>
      <ul>
        {
          capabilities.map((c) => (
            <li data-reveal>
              <a href="#start">
                <h3>{c.name}</h3>
                <p>{c.text}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="cb-process">
      <p class="cb-num">N° 05 — How it goes</p>
      <ol>
        {
          process.map((p) => (
            <li data-reveal>
              <span>{p.n}</span>
              <h3>{p.name}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cb-review">
      <p class="cb-num">N° 06 — In their words</p>
      <blockquote data-reveal>
        <p>“Your Google reviews appear here, quoted in full with the client's name.”</p>
        <footer>Placeholder — real review to be supplied</footer>
      </blockquote>
    </section>

    <section class="cb-cta" id="start">
      <h2 data-reveal>Shall we look at <em>your</em> project?</h2>
      <a class="cb-btn cb-btn-light" href="#start"><span>Request a quote</span></a>
      <p>
        or call <a href={site.phoneHref}>{site.phone}</a> · <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </section>

    <footer class="cb-foot">
      <p>{site.name}</p>
      <p>{site.address.join(', ')}</p>
      <p>{site.area}</p>
    </footer>
  </div>
</ConceptLayout>

<style is:global>
  .cb {
    --paper: #f3eee5;
    --ink: #1d1b17;
    --mute: #6f6a60;
    --line: rgba(29, 27, 23, 0.16);
    --moss: #37432f;
    --clay: #a8643c;
    --pad: clamp(20px, 4.5vw, 72px);
    --serif: 'Fraunces Variable', Georgia, serif;
    background: var(--paper);
    color: var(--ink);
    font:
      400 16px/1.6 'Hanken Grotesk Variable',
      system-ui,
      sans-serif;
    overflow-x: clip;
  }
  .cb h1,
  .cb h2,
  .cb h3,
  .cb-note-text,
  .cb blockquote p,
  .cb-logo-is {
    font-family: var(--serif);
    font-weight: 300;
    font-variation-settings:
      'opsz' 144,
      'SOFT' 50;
    letter-spacing: -0.02em;
  }
  .cb em {
    font-style: italic;
    color: var(--clay);
  }
  .cb-num,
  .cb-eyebrow {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .cb-head {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 26px var(--pad);
    border-bottom: 1px solid var(--line);
    font-size: 14px;
  }
  .cb-head nav {
    display: flex;
    gap: 28px;
    align-items: center;
  }
  .cb-head nav:last-child {
    justify-content: flex-end;
  }
  .cb-head a {
    text-decoration: none;
  }
  .cb-head nav a:not(.cb-link) {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.35s;
  }
  .cb-head nav a:not(.cb-link):hover {
    background-size: 100% 1px;
  }
  .cb-link {
    padding-bottom: 2px;
    border-bottom: 1px solid var(--ink);
  }
  .cb-logo {
    text-align: center;
    line-height: 1;
  }
  .cb-logo-is {
    display: block;
    font-size: 34px;
    font-weight: 400 !important;
  }
  .cb-logo-sub {
    display: block;
    margin-top: 6px;
    font-size: 10px;
    letter-spacing: 0.34em;
    text-transform: uppercase;
  }
  .cb-logo-sub i {
    font-style: normal;
    color: var(--clay);
  }

  .cb-hero {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 80px);
    padding: clamp(40px, 6vw, 96px) var(--pad) clamp(72px, 9vw, 140px);
    align-items: center;
  }
  .cb h1 {
    margin-top: 28px;
    font-size: clamp(40px, 6.3vw, 104px);
    line-height: 1;
    max-width: 12ch;
  }
  .cb-lede {
    margin-top: 32px;
    max-width: 42ch;
    font-size: clamp(16px, 1.35vw, 20px);
    color: #47433b;
  }
  .cb-btn {
    display: inline-block;
    margin-top: 36px;
    padding: 17px 30px;
    border-radius: 999px;
    background: var(--moss);
    color: var(--paper);
    text-decoration: none;
    font-size: 15px;
    overflow: hidden;
    position: relative;
    isolation: isolate;
  }
  .cb-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--clay);
    transform: translateY(101%);
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .cb-btn:hover::before {
    transform: none;
  }
  .cb-hero-art {
    position: relative;
    padding-bottom: 12%;
  }
  .cb-hero-tall {
    margin: 0 0 0 auto;
    width: 74%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 999px 999px 0 0;
  }
  .cb-hero-tall img,
  .cb-hero-wide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cb-hero-tall img {
    animation: cb-settle 2.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes cb-settle {
    from {
      transform: scale(1.18);
    }
  }
  .cb-hero-wide {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 52%;
    margin: 0;
    padding: 10px 10px 0;
    background: var(--paper);
  }
  .cb-hero-wide img {
    aspect-ratio: 4 / 3;
  }
  .cb-hero-wide figcaption {
    padding: 10px 0 0;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .cb-note {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: 32px;
    padding: clamp(72px, 10vw, 150px) var(--pad);
    border-top: 1px solid var(--line);
  }
  .cb-note-text {
    font-size: clamp(26px, 3.6vw, 58px);
    line-height: 1.14;
    max-width: 24ch;
  }

  .cb-sectors {
    padding: 0 var(--pad) clamp(72px, 10vw, 150px);
  }
  .cb-sectors > .cb-num {
    margin-bottom: 28px;
  }
  .cb-sector {
    display: grid;
    grid-template-columns: 60px minmax(0, 4fr) minmax(0, 4fr) minmax(0, 3fr);
    gap: 32px;
    align-items: center;
    padding: 30px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }
  .cb-sector:last-child {
    border-bottom: 1px solid var(--line);
  }
  .cb-sector-n {
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--mute);
  }
  .cb-sector h2 {
    font-size: clamp(38px, 6vw, 100px);
    line-height: 1;
    transition:
      color 0.4s,
      font-variation-settings 0.4s,
      transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .cb-sector:hover h2 {
    color: var(--clay);
    transform: translateX(12px);
    font-style: italic;
  }
  .cb-sector p {
    color: #47433b;
    max-width: 40ch;
  }
  .cb-sector p b {
    display: block;
    color: var(--ink);
    font-weight: 500;
  }
  .cb-sector figure {
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .cb-sector img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .cb-sector:hover img {
    transform: scale(1.07);
  }

  .cb-gallery {
    padding: clamp(56px, 7vw, 100px) 0;
    background: #e9e2d5;
  }
  .cb-gallery-head {
    display: flex;
    justify-content: space-between;
    padding: 0 var(--pad) 28px;
    font-size: 13px;
    color: var(--mute);
  }
  .cb-gallery-track {
    display: flex;
    align-items: flex-end;
    gap: clamp(14px, 2vw, 28px);
    padding: 0 var(--pad);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }
  .cb-gallery-track::-webkit-scrollbar {
    display: none;
  }
  .cb-gallery-track figure {
    flex: 0 0 auto;
    margin: 0;
    width: min(46vw, 760px);
    aspect-ratio: 3 / 2;
    overflow: hidden;
    scroll-snap-align: center;
  }
  .cb-gallery-track figure.is-tall {
    width: min(26vw, 420px);
    aspect-ratio: 2 / 3;
  }
  .cb-gallery-track img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cb-caps {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: clamp(32px, 6vw, 96px);
    padding: clamp(72px, 10vw, 150px) var(--pad);
  }
  .cb-caps h2 {
    margin-top: 24px;
    font-size: clamp(32px, 4.2vw, 68px);
    line-height: 1.02;
    max-width: 8ch;
  }
  .cb-caps ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 40px;
  }
  .cb-caps li a {
    display: block;
    padding: 26px 0 30px;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }
  .cb-caps h3 {
    font-size: clamp(22px, 2.2vw, 34px);
    transition: color 0.3s;
  }
  .cb-caps li a:hover h3 {
    color: var(--clay);
    font-style: italic;
  }
  .cb-caps li p {
    margin-top: 8px;
    color: var(--mute);
    max-width: 36ch;
  }

  .cb-process {
    padding: clamp(56px, 7vw, 100px) var(--pad);
    background: var(--moss);
    color: var(--paper);
  }
  .cb-process .cb-num {
    color: rgba(243, 238, 229, 0.6);
  }
  .cb-process ol {
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 28px;
  }
  .cb-process li span {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(243, 238, 229, 0.45);
    border-radius: 50%;
    font-size: 12px;
  }
  .cb-process li h3 {
    margin: 26px 0 8px;
    font-size: clamp(22px, 2vw, 30px);
  }
  .cb-process li p {
    color: rgba(243, 238, 229, 0.72);
    font-size: 15px;
  }

  .cb-review {
    padding: clamp(72px, 10vw, 150px) var(--pad);
    text-align: center;
  }
  .cb-review blockquote {
    margin: 36px auto 0;
    max-width: 900px;
  }
  .cb-review blockquote p {
    font-size: clamp(26px, 3.8vw, 58px);
    line-height: 1.14;
    font-style: italic;
  }
  .cb-review footer {
    margin-top: 28px;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .cb-cta {
    padding: clamp(80px, 11vw, 170px) var(--pad);
    background: var(--ink);
    color: var(--paper);
    text-align: center;
  }
  .cb-cta h2 {
    font-size: clamp(40px, 7.4vw, 124px);
    line-height: 1;
  }
  .cb-btn-light {
    background: var(--paper);
    color: var(--ink);
  }
  .cb-btn-light:hover {
    color: var(--paper);
  }
  .cb-cta p {
    margin-top: 26px;
    font-size: 14px;
    color: rgba(243, 238, 229, 0.65);
  }
  .cb-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    padding: 28px var(--pad) 90px;
    background: var(--ink);
    color: rgba(243, 238, 229, 0.55);
    font-size: 13px;
    border-top: 1px solid rgba(243, 238, 229, 0.14);
  }

  @media (max-width: 900px) {
    .cb-head {
      grid-template-columns: 1fr auto;
    }
    .cb-head nav:first-child,
    .cb-head nav:last-child a:not(.cb-link) {
      display: none;
    }
    .cb-logo {
      grid-column: 1;
      grid-row: 1;
      text-align: left;
    }
    .cb-hero,
    .cb-note,
    .cb-caps {
      grid-template-columns: 1fr;
    }
    .cb-sector {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .cb-caps ul {
      grid-template-columns: 1fr;
    }
    .cb-process ol {
      grid-template-columns: 1fr 1fr;
    }
    .cb-gallery-track figure {
      width: 78vw;
    }
    .cb-gallery-track figure.is-tall {
      width: 52vw;
    }
  }
</style>
