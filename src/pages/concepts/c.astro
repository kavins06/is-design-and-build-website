---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import { Image } from 'astro:assets';
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import { site, sectors, capabilities, process } from '../../data/site';
import built from '../../assets/photos/deck-a.jpg';
import k from '../../assets/photos/kitchen-a.jpg';
import b from '../../assets/photos/bath-a.jpg';
import r from '../../assets/photos/roof-a.jpg';

// Each stroke of the elevation is drawn in sequence.
const strokes = [
  'M8 470H346',
  'M8 470V150H96',
  'M304 170H340V470',
  'M96 470V96H304V470',
  'M86 96H314M90 82H310M90 82V96M310 82V96',
  'M110 96v-6M130 96v-6M150 96v-6M170 96v-6M190 96v-6M210 96v-6M230 96v-6M250 96v-6M270 96v-6M290 96v-6',
  'M96 214H304M96 332H304',
  'M200 96V470',
  'M118 124h60v70h-60zM148 124v70M118 159h60',
  'M222 124h60v70h-60zM252 124v70M222 159h60',
  'M118 240h60v72h-60zM148 240v72M118 276h60',
  'M222 240h60v72h-60zM252 240v72M222 276h60',
  'M118 360h60v62h-60zM148 360v62',
  'M224 352h56v118h-56zM224 376h56M252 376v94',
  'M212 470v-10h80v10M218 460v-10h68v10',
  'M270 414h4',
];
const dims = ['M358 96V470M352 96h12M352 470h12', 'M96 496H304M96 490v12M304 490v12'];
---

<ConceptLayout title="Direction C · Drawing Set — I.S Design + Build" current="c">
  <div class="cc">
    <header class="cc-head">
      <a class="cc-logo" href="/concepts/c/" aria-label={site.name}>
        <svg viewBox="0 0 44 44" width="38" height="38" aria-hidden="true">
          <path d="M2 2h40v40H2z" fill="none" stroke="currentColor" stroke-width="2"></path>
          <path d="M13 12v20" stroke="currentColor" stroke-width="4"></path>
          <path d="M33 14h-9v8h9v8h-9" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="miter"></path>
          <circle cx="19.5" cy="30" r="2" fill="var(--signal)"></circle>
        </svg>
        <span>Design + Build</span>
      </a>
      <nav aria-label="Primary">
        <a href="#sectors">Sectors</a>
        <a href="#capabilities">Capabilities</a>
        <a href="#process">Process</a>
        <a href="#work">Work</a>
      </nav>
      <a class="cc-btn" href="#start">Get a quote</a>
    </header>

    <section class="cc-hero">
      <div class="cc-hero-copy">
        <p class="cc-tag">Sheet A-001 · General contractor · Est. {site.since}</p>
        <h1>
          <span>Drawn.</span>
          <span>Permitted.</span>
          <span class="is-built">Built.</span>
        </h1>
        <p class="cc-lede">
          I.S Design + Build takes homes, commercial spaces and public buildings from the first line on paper to the final
          inspection. One firm holds the whole job.
        </p>
        <div class="cc-actions">
          <a class="cc-btn cc-btn-solid" href="#start">Start a project →</a>
          <a class="cc-btn" href={site.phoneHref}>{site.phone}</a>
        </div>
      </div>

      <div class="cc-drawing">
        <svg viewBox="0 0 400 520" role="img" aria-label="Line drawing of a Washington rowhouse elevation being drafted">
          <g class="cc-strokes">
            {strokes.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} />)}
          </g>
          <g class="cc-dims">
            {dims.map((d, i) => <path d={d} pathLength="1" style={`--i:${strokes.length + i}`} />)}
            <text x="364" y="288" style={`--i:${strokes.length + 2}`}>38'-0"</text>
            <text x="200" y="514" text-anchor="middle" style={`--i:${strokes.length + 2}`}>20'-0"</text>
          </g>
        </svg>
        <dl class="cc-titleblock">
          <div><dt>Project</dt><dd>Rowhouse renovation</dd></div>
          <div><dt>Drawing</dt><dd>Front elevation</dd></div>
          <div><dt>Scale</dt><dd>1/4" = 1'-0"</dd></div>
          <div><dt>Sheet</dt><dd>A-201</dd></div>
        </dl>
      </div>
    </section>

    <section class="cc-split" id="work">
      <div class="cc-split-text">
        <p class="cc-tag">Fig. 01 · From sheet to site</p>
        <h2 data-reveal>Every line on the drawing is one we will build ourselves.</h2>
        <p data-reveal>
          Designers who never swing a hammer draw things that cost twice what they should. Our drawings are made by the people
          who price and build them, so the number holds and the details work.
        </p>
      </div>
      <figure class="cc-split-img" data-reveal>
        <Image src={built} alt="Rear terrace and spiral stair of a renovated rowhouse" widths={[700, 1200, 1800]} sizes="(min-width: 900px) 55vw, 100vw" />
        <figcaption>As built · Washington, DC</figcaption>
      </figure>
    </section>

    <section class="cc-sectors" id="sectors">
      <p class="cc-tag">Sheet A-100 · Sectors</p>
      <div class="cc-sector-grid">
        {
          sectors.map((s, i) => (
            <a class="cc-sector" href="#start" data-reveal style={`transition-delay:${i * 80}ms`}>
              <span>{`S-${i + 1}`}</span>
              <h3>{s.name}</h3>
              <p class="cc-sector-line">{s.line}</p>
              <p>{s.text}</p>
              <i>View sector →</i>
            </a>
          ))
        }
      </div>
    </section>

    <section class="cc-caps" id="capabilities">
      <div class="cc-caps-head">
        <p class="cc-tag">Sheet A-300 · Capability schedule</p>
        <h2>Whatever the building needs, it is on our schedule.</h2>
      </div>
      <table>
        <thead>
          <tr><th>No.</th><th>Discipline</th><th>Scope</th><th></th></tr>
        </thead>
        <tbody>
          {
            capabilities.map((c) => (
              <tr>
                <td>{c.n}</td>
                <td>{c.name}</td>
                <td>{c.text}</td>
                <td>→</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <div class="cc-caps-imgs">
        <Image src={k} alt="Kitchen with timber cabinetry" widths={[500, 800]} sizes="(min-width: 900px) 30vw, 90vw" />
        <Image src={b} alt="Bathroom in dark marble with a floating vanity" widths={[500, 800]} sizes="(min-width: 900px) 30vw, 90vw" />
        <Image src={r} alt="Roof terrace at dusk" widths={[500, 800]} sizes="(min-width: 900px) 30vw, 90vw" />
      </div>
    </section>

    <section class="cc-process" id="process">
      <p class="cc-tag">Sheet A-400 · Programme</p>
      <h2>Five stages. You always know which one you are in.</h2>
      <ol>
        {
          process.map((p, i) => (
            <li data-reveal style={`--start:${i + 1}`}>
              <div class="cc-bar"></div>
              <span>{p.n}</span>
              <h3>{p.name}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cc-review">
      <p class="cc-tag">Client record</p>
      <blockquote data-reveal>
        <p>Your Google reviews appear here, quoted in full with the client's name.</p>
        <footer>Placeholder · real review to be supplied</footer>
      </blockquote>
      <ul>
        <li><b>{site.since}</b>Building in Washington since</li>
        <li><b>3</b>Sectors: residential, commercial, government</li>
        <li><b>1</b>Contract from design to handover</li>
      </ul>
    </section>

    <section class="cc-cta" id="start">
      <p class="cc-tag">Next sheet</p>
      <h2 data-reveal>Bring us the problem. We will draw the answer and build it.</h2>
      <div class="cc-actions">
        <a class="cc-btn cc-btn-solid" href="#start">Get a quote →</a>
        <a class="cc-btn" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </section>

    <footer class="cc-foot">
      <p>{site.name} · General contractor · Since {site.since}</p>
      <p>{site.address.join(', ')}</p>
      <p>{site.area}</p>
    </footer>
  </div>
</ConceptLayout>

<style is:global>
  .cc {
    --paper: #f5f4ef;
    --ink: #0f2440;
    --mute: #5d6b80;
    --line: rgba(15, 36, 64, 0.16);
    --grid: rgba(15, 36, 64, 0.055);
    --signal: #ff5418;
    --pad: clamp(20px, 4vw, 64px);
    --mono: 'Geist Mono Variable', ui-monospace, monospace;
    background-color: var(--paper);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 32px 32px;
    color: var(--ink);
    font:
      400 16px/1.55 'Geist Variable',
      system-ui,
      sans-serif;
    overflow-x: clip;
  }
  .cc h1,
  .cc h2 {
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }
  .cc h2 {
    font-size: clamp(30px, 4.4vw, 72px);
    max-width: 18ch;
  }
  .cc-tag {
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .cc-tag::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 10px;
    background: var(--signal);
  }

  .cc-head {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 14px var(--pad);
    background: rgba(245, 244, 239, 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .cc-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .cc-head nav {
    display: flex;
    gap: 26px;
    margin-left: auto;
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .cc-head nav a {
    text-decoration: none;
  }
  .cc-head nav a:hover {
    color: var(--signal);
  }
  .cc-btn {
    display: inline-flex;
    align-items: center;
    padding: 13px 18px;
    border: 1px solid var(--ink);
    text-decoration: none;
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition:
      background 0.2s,
      color 0.2s,
      box-shadow 0.2s,
      transform 0.2s;
  }
  .cc-btn:hover {
    transform: translate(-3px, -3px);
    box-shadow: 3px 3px 0 var(--ink);
  }
  .cc-btn-solid {
    background: var(--signal);
    border-color: var(--signal);
    color: #fff;
  }
  .cc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .cc-hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    min-height: calc(100svh - 68px);
    padding: clamp(32px, 5vw, 72px) var(--pad);
  }
  .cc h1 {
    margin-top: 28px;
    font-size: clamp(54px, 10.5vw, 176px);
  }
  .cc h1 span {
    display: block;
    animation: cc-in 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .cc h1 span:nth-child(2) {
    animation-delay: 0.9s;
  }
  .cc h1 span.is-built {
    animation-delay: 1.9s;
    color: var(--signal);
  }
  @keyframes cc-in {
    from {
      opacity: 0;
      transform: translateX(-24px);
    }
  }
  .cc-lede {
    margin-top: 32px;
    max-width: 46ch;
    font-size: clamp(16px, 1.35vw, 20px);
    color: #2f4260;
  }

  .cc-drawing {
    position: relative;
    border: 1px solid var(--ink);
    background: rgba(245, 244, 239, 0.75);
  }
  .cc-drawing svg {
    display: block;
    width: 100%;
    max-height: 62svh;
    padding: 18px;
  }
  .cc-strokes path,
  .cc-dims path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-linecap: square;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: cc-draw 0.9s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    animation-delay: calc(0.3s + var(--i) * 0.16s);
  }
  .cc-dims path {
    stroke: var(--signal);
    stroke-width: 1;
  }
  .cc-dims text {
    font: 500 10px var(--mono);
    fill: var(--signal);
    opacity: 0;
    animation: cc-fade 0.6s forwards;
    animation-delay: calc(0.3s + var(--i) * 0.16s);
  }
  @keyframes cc-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes cc-fade {
    to {
      opacity: 1;
    }
  }
  .cc-titleblock {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    border-top: 1px solid var(--ink);
    font: 500 10px/1.3 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .cc-titleblock div {
    padding: 10px 12px;
  }
  .cc-titleblock div + div {
    border-left: 1px solid var(--ink);
  }
  .cc-titleblock dt {
    color: var(--mute);
  }
  .cc-titleblock dd {
    margin: 4px 0 0;
  }

  .cc-split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    border-block: 1px solid var(--ink);
    background: var(--paper);
  }
  .cc-split-text {
    padding: clamp(40px, 6vw, 96px) var(--pad);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
  }
  .cc-split-text p:last-child {
    max-width: 46ch;
    color: #2f4260;
    font-size: clamp(15px, 1.25vw, 18px);
  }
  .cc-split-img {
    position: relative;
    margin: 0;
    border-left: 1px solid var(--ink);
    min-height: 420px;
    clip-path: inset(0 0 0 0);
  }
  .cc-split-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cc-split-img figcaption {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 9px 12px;
    background: var(--ink);
    color: var(--paper);
    font: 500 10px/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .cc-sectors,
  .cc-caps,
  .cc-process,
  .cc-review {
    padding: clamp(72px, 9vw, 140px) var(--pad);
  }
  .cc-sector-grid {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--ink);
    background: var(--paper);
  }
  .cc-sector {
    display: flex;
    flex-direction: column;
    min-height: clamp(320px, 34vw, 460px);
    padding: clamp(20px, 2.4vw, 36px);
    text-decoration: none;
    transition:
      background 0.3s,
      color 0.3s;
  }
  .cc-sector + .cc-sector {
    border-left: 1px solid var(--ink);
  }
  .cc-sector span {
    font: 500 11px/1 var(--mono);
    color: var(--signal);
  }
  .cc-sector h3 {
    margin-top: auto;
    font-size: clamp(30px, 3.6vw, 58px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .cc-sector-line {
    margin: 14px 0 6px;
    font-weight: 500;
  }
  .cc-sector p:not(.cc-sector-line) {
    opacity: 0.75;
    font-size: 15px;
    max-width: 36ch;
  }
  .cc-sector i {
    margin-top: 22px;
    font: 500 11px/1 var(--mono);
    font-style: normal;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cc-sector:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .cc-caps {
    background: var(--ink);
    color: var(--paper);
    background-image:
      linear-gradient(rgba(245, 244, 239, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(245, 244, 239, 0.05) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  .cc-caps .cc-tag {
    color: rgba(245, 244, 239, 0.6);
  }
  .cc-caps h2 {
    margin-top: 24px;
  }
  .cc-caps table {
    width: 100%;
    margin-top: 48px;
    border-collapse: collapse;
  }
  .cc-caps th {
    padding: 10px 14px 10px 0;
    text-align: left;
    font: 500 10px/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(245, 244, 239, 0.55);
    border-bottom: 1px solid rgba(245, 244, 239, 0.6);
  }
  .cc-caps td {
    padding: 20px 14px 20px 0;
    border-bottom: 1px solid rgba(245, 244, 239, 0.18);
    vertical-align: baseline;
    transition: color 0.2s;
  }
  .cc-caps td:first-child {
    width: 70px;
    font: 500 12px var(--mono);
    color: var(--signal);
  }
  .cc-caps td:nth-child(2) {
    font-size: clamp(20px, 2.2vw, 34px);
    font-weight: 500;
    letter-spacing: -0.03em;
    width: 38%;
  }
  .cc-caps td:nth-child(3) {
    color: rgba(245, 244, 239, 0.7);
  }
  .cc-caps td:last-child {
    width: 30px;
    text-align: right;
  }
  .cc-caps tbody tr:hover td {
    color: var(--signal);
  }
  .cc-caps-imgs {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .cc-caps-imgs img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 1px solid rgba(245, 244, 239, 0.4);
  }

  .cc-process h2 {
    margin-top: 24px;
  }
  .cc-process ol {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-left: 1px solid var(--line);
  }
  .cc-process li {
    padding: 0 18px 8px;
    border-right: 1px solid var(--line);
  }
  .cc-bar {
    height: 12px;
    margin: 0 -18px 22px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--start) * 0.14s);
  }
  .cc-process li:last-child .cc-bar {
    background: var(--signal);
  }
  .cc-process li.is-in .cc-bar {
    transform: none;
  }
  .cc-process li span {
    font: 500 11px var(--mono);
    color: var(--mute);
  }
  .cc-process li h3 {
    margin: 10px 0 6px;
    font-size: clamp(18px, 1.7vw, 25px);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .cc-process li p {
    font-size: 15px;
    color: #2f4260;
  }

  .cc-review {
    border-top: 1px solid var(--ink);
    background: var(--paper);
  }
  .cc-review blockquote {
    margin: 32px 0 0;
    padding: clamp(24px, 4vw, 56px);
    border: 1px dashed var(--ink);
  }
  .cc-review blockquote p {
    font-size: clamp(24px, 3.2vw, 50px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.08;
    max-width: 24ch;
  }
  .cc-review footer {
    margin-top: 24px;
    font: 500 11px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .cc-review ul {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .cc-review li {
    padding-top: 14px;
    border-top: 1px solid var(--ink);
    font-size: 14px;
    color: var(--mute);
  }
  .cc-review li b {
    display: block;
    font-size: clamp(40px, 6vw, 96px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--ink);
  }

  .cc-cta {
    padding: clamp(80px, 11vw, 170px) var(--pad);
    background: var(--signal);
    color: #fff;
  }
  .cc-cta .cc-tag {
    color: rgba(255, 255, 255, 0.8);
  }
  .cc-cta .cc-tag::before {
    background: #fff;
  }
  .cc-cta h2 {
    margin-top: 24px;
    font-size: clamp(36px, 6.6vw, 112px);
    max-width: 14ch;
  }
  .cc-cta .cc-btn {
    border-color: #fff;
  }
  .cc-cta .cc-btn-solid {
    background: var(--ink);
    border-color: var(--ink);
  }
  .cc-cta .cc-btn:hover {
    box-shadow: 3px 3px 0 #fff;
  }
  .cc-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 32px;
    padding: 22px var(--pad) 90px;
    background: var(--ink);
    color: rgba(245, 244, 239, 0.7);
    font: 500 11px/1.5 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .cc-head nav {
      display: none;
    }
    .cc-head .cc-btn {
      margin-left: auto;
    }
    .cc-hero,
    .cc-split,
    .cc-sector-grid,
    .cc-caps-imgs,
    .cc-review ul {
      grid-template-columns: 1fr;
    }
    .cc-split-img {
      border-left: 0;
      border-top: 1px solid var(--ink);
    }
    .cc-sector + .cc-sector {
      border-left: 0;
