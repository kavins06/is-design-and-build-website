---
import BaseLayout from '../../layouts/BaseLayout.astro';

const directions = [
  { href: '/concepts/a/', name: 'A · Monolith' },
  { href: '/concepts/b/', name: 'B · Atelier' },
  { href: '/concepts/c/', name: 'C · Drawing Set' },
  { href: '/concepts/d/', name: 'D · C + A' },
  { href: '/concepts/e/', name: 'E · Heritage' },
  { href: '/concepts/f/', name: 'F · Institutional' },
  { href: '/concepts/g/', name: 'G · D + F (chosen; now the home page)' },
];
---

<BaseLayout title="Design directions — I.S Design + Build">
  <meta slot="head" name="robots" content="noindex" />
  <main style="max-width:640px;margin:12vh auto;padding:0 20px;font:18px/1.6 system-ui,sans-serif">
    <h1>Design directions</h1>
    <p>Earlier explorations, kept for reference. <a href="/">Back to the home page</a>.</p>
    <ul>
      {directions.map((d) => <li><a href={d.href}>{d.name}</a></li>)}
    </ul>
  </main>
</BaseLayout>
