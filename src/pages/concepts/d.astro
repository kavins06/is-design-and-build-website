---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/geist-mono';
import { Image } from 'astro:assets';
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import { site, sectors, capabilities, process } from '../../data/site';
import hero from '../../assets/photos/deck-a.jpg';
import res from '../../assets/photos/kitchen-a.jpg';
import com from '../../assets/photos/exterior-a.jpg';
import gov from '../../assets/photos/roof-a.jpg';

const sectorImg = { residential: res, commercial: com, government: gov } as const;
const years = new Date().getFullYear() - site.since;

// Each stroke of the elevation is drawn in sequence.
const strokes = [
  'M8 470H346',
  'M8 470V150H96',
  'M304 170H340V470',
  'M96 470V96H304V470',
  'M86 96H314M90 82H310M90 82V96M310 82V96',
  'M110 96v-6M130 96v-6M150 96v-6M170 96v-6M190 96v-6M210 96v-6M230 96v-6M250 96v-6M270 96v-6M290 96v-6',
  'M96 214H304M96 332H304',
  'M200 96V470',
  'M118 124h60v70h-60zM148 124v70M118 159h60',
  'M222 124h60v70h-60zM252 124v70M222 159h60',
  'M118 240h60v72h-60zM148 240v72M118 276h60',
  'M222 240h60v72h-60zM252 240v72M222 276h60',
  'M118 360h60v62h-60zM148 360v62',
  'M224 352h56v118h-56zM224 376h56M252 376v94',
  'M212 470v-10h80v10M218 460v-10h68v10',
  'M270 414h4',
];
const dims = ['M358 96V470M352 96h12M352 470h12', 'M96 496H304M96 490v12M304 490v12'];
---

<ConceptLayout title="Direction D · Drawing Set with Monolith weight — I.S Design + Build" current="d">
  <div class="cd">
    <header class="cd-head">
      <a class="cd-logo" href="/concepts/d/" aria-label={site.name}>
        <svg viewBox="0 0 44 44" width="38" height="38" aria-hidden="true">
          <path d="M2 2h40v40H2z" fill="none" stroke="currentColor" stroke-width="2.5"></path>
          <path d="M13 12v20" stroke="currentColor" stroke-width="4.5"></path>
          <path d="M33 14h-9v8h9v8h-9" fill="none" stroke="currentColor" stroke-width="4.5"></path>
          <circle cx="19.5" cy="30" r="2.2" fill="var(--signal)"></circle>
        </svg>
        <span>Design + Build</span>
      </a>
      <nav aria-label="Primary">
        <a href="#sectors">Residential</a>
        <a href="#sectors">Commercial</a>
        <a href="#sectors">Government</a>
        <a href="#capabilities">Capabilities</a>
        <a href="#process">Process</a>
      </nav>
      <a class="cd-btn" href="#start">Get a quote</a>
    </header>

    <section class="cd-hero">
      <Image src={hero} alt="Rear terrace and spiral stair of a renovated Washington rowhouse" widths={[900, 1500, 2200]} sizes="100vw" loading="eager" class="cd-hero-img" />
      <div class="cd-hero-shade"></div>

      <svg class="cd-elev" viewBox="0 0 400 520" role="img" aria-label="Line drawing of a rowhouse elevation being drafted">
        <g class="cd-strokes">
          {strokes.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} />)}
        </g>
        <g class="cd-dims">
          {dims.map((d, i) => <path d={d} pathLength="1" style={`--i:${strokes.length + i}`} />)}
          <text x="364" y="288" style={`--i:${strokes.length + 2}`}>38'-0"</text>
          <text x="200" y="514" text-anchor="middle" style={`--i:${strokes.length + 2}`}>20'-0"</text>
        </g>
      </svg>

      <div class="cd-hero-copy">
        <p class="cd-tag">Sheet A-001 · General contractor · Est. {site.since}</p>
        <h1>
          <span>Drawn.</span>
          <span>Permitted.</span>
          <span class="is-built">Built.</span>
        </h1>
        <div class="cd-hero-foot">
          <p>
            One firm takes homes, commercial spaces and public buildings from the first line on paper to the final inspection.
          </p>
          <a class="cd-btn cd-btn-solid" href="#start">Start a project →</a>
        </div>
      </div>

      <dl class="cd-titleblock">
        <div><dt>Project</dt><dd>Rowhouse renovation</dd></div>
        <div><dt>Drawing</dt><dd>Front elevation</dd></div>
        <div><dt>Status</dt><dd class="cd-status">Built</dd></div>
      </dl>
    </section>

    <div class="cd-marquee" aria-hidden="true">
      <div>
        {[0, 1].map(() => capabilities.map((c) => <span>{c.name}</span>))}
      </div>
    </div>

    <section class="cd-statement">
      <p class="cd-tag">Fig. 01 · The firm</p>
      <h2 data-reveal>
        Every line on the drawing is one <em>we will build ourselves.</em> So the price holds, the permit clears, and the details
        work.
      </h2>
    </section>

    <section class="cd-sectors" id="sectors">
      {
        sectors.map((s, i) => (
          <a class="cd-sector" href="#start" data-reveal style={`transition-delay:${i * 90}ms`}>
            <Image src={sectorImg[s.slug as keyof typeof sectorImg]} alt="" widths={[600, 900]} sizes="(min-width: 900px) 33vw, 100vw" />
            <span class="cd-sector-id">S-{i + 1}</span>
            <div>
              <h3>{s.name}</h3>
              <p>{s.text}</p>
            </div>
          </a>
        ))
      }
    </section>

    <section class="cd-caps" id="capabilities">
      <div class="cd-caps-head">
        <p class="cd-tag">Sheet A-300 · Capability schedule</p>
        <h2>Six disciplines.<br />One contract.</h2>
      </div>
      <table>
        <thead>
          <tr><th>No.</th><th>Discipline</th><th>Scope</th><th></th></tr>
        </thead>
        <tbody>
          {
            capabilities.map((c) => (
              <tr>
                <td>{c.n}</td>
                <td>{c.name}</td>
                <td>{c.text}</td>
                <td>→</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="cd-year">
      <p class="cd-year-num" aria-hidden="true">{site.since}</p>
      <div data-reveal>
        <h2>{years} years on DC job sites.</h2>
        <p>
          We have been building in this city since {site.since}. Its rowhouses, its permit process and its inspectors are familiar
          ground.
        </p>
      </div>
    </section>

    <section class="cd-process" id="process">
      <p class="cd-tag">Sheet A-400 · Programme</p>
      <ol>
        {
          process.map((p, i) => (
            <li data-reveal style={`--start:${i + 1}`}>
              <div class="cd-bar"></div>
              <span>{p.n}</span>
              <h3>{p.name}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cd-review">
      <p class="cd-tag">Client record</p>
      <blockquote data-reveal>
        <p>Your Google reviews appear here, quoted in full with the client's name.</p>
        <footer>Placeholder · real review to be supplied</footer>
      </blockquote>
    </section>

    <section class="cd-cta" id="start">
      <p class="cd-tag">Next sheet</p>
      <h2 data-reveal>Tell us what you're building.</h2>
      <div>
        <a class="cd-btn cd-btn-solid" href="#start">Get a quote →</a>
        <a class="cd-btn" href={site.phoneHref}>{site.phone}</a>
      </div>
    </section>

    <footer class="cd-foot">
      <p>{site.name} · General contractor · Since {site.since}</p>
      <p>{site.address.join(', ')}</p>
      <p>{site.email}</p>
      <p>{site.area}</p>
    </footer>
  </div>
</ConceptLayout>

<style is:global>
  .cd {
    --bg: #090d14;
    --ink: #eef0f3;
    --mute: #8792a3;
    --line: rgba(238, 240, 243, 0.16);
    --grid: rgba(238, 240, 243, 0.045);
    --signal: #ff5418;
    --pad: clamp(20px, 4vw, 64px);
    --mono: 'Geist Mono Variable', ui-monospace, monospace;
    --t-built: 3.3s;
    background-color: var(--bg);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 40px 40px;
    color: var(--ink);
    font:
      400 16px/1.55 'Archivo Variable',
      system-ui,
      sans-serif;
    overflow-x: clip;
  }
  .cd h1,
  .cd h2,
  .cd-year-num {
    font-stretch: 125%;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 0.9;
  }
  .cd-tag {
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .cd-tag::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 10px;
    background: var(--signal);
  }

  .cd-head {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 20px var(--pad);
  }
  .cd-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    white-space: nowrap;
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .cd-head nav {
    display: flex;
    gap: 26px;
    margin-left: auto;
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .cd-head nav a {
    text-decoration: none;
    transition: color 0.2s;
  }
  .cd-head nav a:hover {
    color: var(--signal);
  }
  .cd-btn {
    display: inline-flex;
    align-items: center;
    padding: 14px 20px;
    border: 1px solid var(--ink);
    text-decoration: none;
    white-space: nowrap;
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition:
      box-shadow 0.2s,
      transform 0.2s;
  }
  .cd-btn:hover {
    transform: translate(-3px, -3px);
    box-shadow: 3px 3px 0 var(--ink);
  }
  .cd-btn-solid {
    background: var(--signal);
    border-color: var(--signal);
    color: #fff;
  }

  /* Hero: the drawing is drafted first, then the built photo is revealed behind it. */
  .cd-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .cd-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    clip-path: inset(100% 0 0 0);
    animation:
      cd-reveal 1.6s cubic-bezier(0.7, 0, 0.2, 1) var(--t-built) forwards,
      cd-zoom 20s ease-out var(--t-built) forwards;
  }
  @keyframes cd-reveal {
    to {
      clip-path: inset(0);
    }
  }
  @keyframes cd-zoom {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1);
    }
  }
  .cd-hero-shade {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: linear-gradient(180deg, rgba(9, 13, 20, 0.78) 0%, rgba(9, 13, 20, 0.35) 35%, rgba(9, 13, 20, 0.7) 68%, #090d14 100%);
    animation: cd-fade 1.6s var(--t-built) forwards;
  }
  .cd-elev {
    position: absolute;
    right: var(--pad);
    top: 50%;
    height: min(74svh, 760px);
    transform: translateY(-52%);
    animation: cd-dim 1.6s calc(var(--t-built) + 0.4s) forwards;
  }
  @keyframes cd-dim {
    to {
      opacity: 0.5;
    }
  }
  .cd-strokes path,
  .cd-dims path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
    stroke-linecap: square;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: cd-draw 0.9s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    animation-delay: calc(0.2s + var(--i) * 0.15s);
  }
  .cd-dims path {
    stroke: var(--signal);
    stroke-width: 1;
  }
  .cd-dims text {
    font: 500 10px var(--mono);
    fill: var(--signal);
    opacity: 0;
    animation: cd-fade 0.6s forwards;
    animation-delay: calc(0.2s + var(--i) * 0.15s);
  }
  @keyframes cd-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes cd-fade {
    to {
      opacity: 1;
    }
  }
  .cd-hero-copy {
    position: relative;
    width: 100%;
    padding: 0 var(--pad) clamp(76px, 8vw, 110px);
  }
  .cd h1 {
    margin-top: 22px;
    font-size: clamp(44px, 9.6vw, 176px);
  }
  .cd h1 span {
    display: block;
    width: max-content;
    animation: cd-rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .cd h1 span:nth-child(1) {
    animation-delay: 0.2s;
  }
  .cd h1 span:nth-child(2) {
    animation-delay: 1.5s;
  }
  .cd h1 span.is-built {
    color: var(--signal);
    animation-delay: var(--t-built);
  }
  @keyframes cd-rise {
    from {
      opacity: 0;
      transform: translateY(0.3em);
    }
  }
  .cd-hero-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-top: clamp(18px, 2.4vw, 32px);
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .cd-hero-foot p {
    max-width: 48ch;
    font-size: clamp(15px, 1.3vw, 19px);
    color: #d3d8e0;
  }
  .cd-titleblock {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    border-top: 1px solid var(--line);
    background: rgba(9, 13, 20, 0.6);
    backdrop-filter: blur(6px);
    font: 500 10px/1.3 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cd-titleblock div {
    display: flex;
    gap: 12px;
    padding: 13px var(--pad);
  }
  .cd-titleblock div + div {
    border-left: 1px solid var(--line);
    padding-left: 18px;
  }
  .cd-titleblock dt {
    color: var(--mute);
  }
  .cd-titleblock dd {
    margin: 0;
  }
  .cd-status {
    color: var(--signal);
    opacity: 0;
    animation: cd-fade 0.4s var(--t-built) forwards;
  }

  .cd-marquee {
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    padding: 18px 0;
  }
  .cd-marquee div {
    display: flex;
    width: max-content;
    animation: cd-marquee 38s linear infinite;
  }
  .cd-marquee span {
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mute);
    white-space: nowrap;
  }
  .cd-marquee span::after {
    content: '+';
    margin: 0 28px;
    color: var(--signal);
  }
  @keyframes cd-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .cd-statement {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: 32px;
    padding: clamp(80px, 12vw, 180px) var(--pad);
  }
  .cd-statement h2 {
    font-stretch: 100%;
    font-weight: 500;
    text-transform: none;
    letter-spacing: -0.03em;
    line-height: 1.06;
    font-size: clamp(28px, 4.4vw, 72px);
    color: var(--mute);
    max-width: 20ch;
  }
  .cd-statement em {
    font-style: normal;
    color: var(--ink);
  }

  .cd-sectors {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-block: 1px solid var(--ink);
  }
  .cd-sector {
    position: relative;
    min-height: clamp(420px, 60vw, 740px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    text-decoration: none;
    background: var(--bg);
  }
  .cd-sector + .cd-sector {
    border-left: 1px solid var(--ink);
  }
  .cd-sector img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) brightness(0.45) contrast(1.1);
    transition:
      filter 0.7s,
      transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .cd-sector:hover img {
    filter: grayscale(0) brightness(0.72);
    transform: scale(1.05);
  }
  .cd-sector-id {
    position: absolute;
    top: 0;
    left: 0;
    padding: 9px 12px;
    background: var(--signal);
    color: #fff;
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.08em;
  }
  .cd-sector div {
    position: relative;
    width: 100%;
    padding: clamp(20px, 2.6vw, 40px);
    background: linear-gradient(0deg, rgba(9, 13, 20, 0.92), transparent);
  }
  .cd-sector h3 {
    font-size: clamp(26px, 3.2vw, 52px);
    font-weight: 800;
    font-stretch: 125%;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .cd-sector p {
    margin-top: 12px;
    max-width: 34ch;
    color: #cdd3dc;
    font-size: 15px;
  }

  .cd-caps {
    padding: clamp(80px, 11vw, 160px) var(--pad);
  }
  .cd-caps h2 {
    margin-top: 24px;
    font-size: clamp(34px, 6.4vw, 112px);
  }
  .cd-caps table {
    width: 100%;
    margin-top: clamp(36px, 5vw, 72px);
    border-collapse: collapse;
  }
  .cd-caps th {
    padding: 10px 14px 10px 0;
    text-align: left;
    font: 500 10px/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mute);
    border-bottom: 1px solid var(--ink);
  }
  .cd-caps td {
    padding: 22px 14px 22px 0;
    border-bottom: 1px solid var(--line);
    vertical-align: baseline;
    transition: color 0.2s;
  }
  .cd-caps td:first-child {
    width: 70px;
    font: 500 12px var(--mono);
    color: var(--signal);
  }
  .cd-caps td:nth-child(2) {
    width: 40%;
    font-size: clamp(22px, 2.6vw, 40px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .cd-caps td:nth-child(3) {
    color: var(--mute);
  }
  .cd-caps td:last-child {
    width: 30px;
    text-align: right;
  }
  .cd-caps tbody tr:hover td {
    color: var(--signal);
  }

  .cd-year {
    padding: clamp(60px, 9vw, 130px) var(--pad);
    border-block: 1px solid var(--line);
  }
  .cd-year-num {
    font-size: clamp(110px, 30vw, 520px);
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(238, 240, 243, 0.6);
    line-height: 0.8 !important;
    margin-left: -0.04em;
  }
  .cd-year div {
    margin-top: clamp(24px, 4vw, 56px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    align-items: end;
  }
  .cd-year h2 {
    font-size: clamp(28px, 4vw, 64px);
  }
  .cd-year div p {
    max-width: 44ch;
    color: #cdd3dc;
    font-size: clamp(15px, 1.3vw, 19px);
  }

  .cd-process,
  .cd-review {
    padding: clamp(80px, 11vw, 160px) var(--pad);
  }
  .cd-process ol {
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-left: 1px solid var(--line);
  }
  .cd-process li {
    padding: 0 18px 8px;
    border-right: 1px solid var(--line);
  }
  .cd-bar {
    height: 14px;
    margin: 0 -18px 22px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--start) * 0.14s);
  }
  .cd-process li:last-child .cd-bar {
    background: var(--signal);
  }
  .cd-process li.is-in .cd-bar {
    transform: none;
  }
  .cd-process li span {
    font: 500 11px var(--mono);
    color: var(--mute);
  }
  .cd-process li h3 {
    margin: 12px 0 6px;
    font-size: clamp(18px, 1.8vw, 27px);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .cd-process li p {
    font-size: 15px;
    color: var(--mute);
  }
  .cd-review {
    padding-top: 0;
  }
  .cd-review blockquote {
    margin: 32px 0 0;
    padding: clamp(28px, 5vw, 72px);
    border: 1px dashed rgba(238, 240, 243, 0.35);
  }
  .cd-review blockquote p {
    font-size: clamp(24px, 3.4vw, 54px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.1;
    max-width: 24ch;
  }
  .cd-review footer {
    margin-top: 26px;
    font: 500 11px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .cd-cta {
    padding: clamp(90px, 13vw, 200px) var(--pad);
    background: var(--signal);
    color: #090d14;
  }
  .cd-cta .cd-tag {
    color: rgba(9, 13, 20, 0.7);
  }
  .cd-cta .cd-tag::before {
    background: #090d14;
  }
  .cd-cta h2 {
    margin-top: 24px;
    font-size: clamp(40px, 9vw, 160px);
    max-width: 10ch;
  }
  .cd-cta div {
    display: flex;
