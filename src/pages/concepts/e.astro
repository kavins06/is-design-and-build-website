---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/hanken-grotesk';
import { Image } from 'astro:assets';
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import { site, sectors, capabilities, process } from '../../data/site';
import hero from '../../assets/stock/town-13.jpg';
import res from '../../assets/stock/home-04.jpg';
import com from '../../assets/stock/office-10.jpg';
import gov from '../../assets/stock/gov-09.jpg';
import capKitchen from '../../assets/stock/kit-08.jpg';
import capBath from '../../assets/stock/bath-06.jpg';
import capHome from '../../assets/stock/home-11.jpg';
import capAddition from '../../assets/stock/site-02.jpg';
import capRoof from '../../assets/stock/town-12.jpg';
import capLead from '../../assets/stock/town-05.jpg';
import craft from '../../assets/stock/craft-01.jpg';

const sectorImg = { residential: res, commercial: com, government: gov } as const;
const capImg = [capKitchen, capBath, capHome, capAddition, capRoof, capLead];
const numerals = ['I', 'II', 'III', 'IV', 'V', 'VI'];
const years = new Date().getFullYear() - site.since;
const quoteTypes = ['Kitchen', 'Bathroom', 'Whole home', 'Addition', 'Roof', 'Lead paint', 'Commercial space', 'Public building'];

const strokes = [
  'M8 470H346',
  'M96 470V96H304V470',
  'M86 96H314M90 82H310M90 82V96M310 82V96',
  'M96 214H304M96 332H304',
  'M118 124h60v70h-60zM148 124v70M118 159h60',
  'M222 124h60v70h-60zM252 124v70M222 159h60',
  'M118 240h60v72h-60zM148 240v72M118 276h60',
  'M222 240h60v72h-60zM252 240v72M222 276h60',
  'M118 360h60v62h-60zM148 360v62M118 391h60',
  'M224 352h56v118h-56zM224 376h56M252 376v94',
  'M224 352a28 28 0 0 1 56 0',
  'M212 470v-10h80v10',
];
---

<ConceptLayout title="Direction E · Heritage — I.S Design + Build" current="e">
  <div class="ce">
    <header class="ce-head">
      <a class="ce-logo" href="/concepts/e/" aria-label={site.name}>
        <svg viewBox="0 0 48 48" width="46" height="46" aria-hidden="true">
          <rect x="1" y="1" width="46" height="46" fill="none" stroke="currentColor" stroke-width="1"></rect>
          <rect x="4.5" y="4.5" width="39" height="39" fill="none" stroke="currentColor" stroke-width="1"></rect>
          <text x="24" y="31" text-anchor="middle" font-family="'Newsreader Variable', Georgia, serif" font-size="21" fill="currentColor">IS</text>
        </svg>
        <span>
          <b>I.S Design + Build</b>
          <small>General contractors · Est. {site.since}</small>
        </span>
      </a>
      <nav aria-label="Primary">
        <a href="#sectors">Residential</a>
        <a href="#sectors">Commercial</a>
        <a href="#sectors">Government</a>
        <a href="#capabilities">Capabilities</a>
        <a href="#firm">The firm</a>
      </nav>
      <a class="ce-phone" href={site.phoneHref}>{site.phone}</a>
      <a class="ce-btn ce-btn-brass" href="#start">Request a quote</a>
    </header>

    <section class="ce-hero">
      <Image src={hero} alt="Federal-style brick townhouse with dark shutters on a tree-lined Georgetown street" widths={[900, 1500, 2400]} sizes="100vw" loading="eager" class="ce-hero-img" />
      <div class="ce-hero-shade"></div>
      <div class="ce-hero-copy">
        <p class="ce-eyebrow">Washington, DC · Since {site.since}</p>
        <h1>Designed, permitted and built by <em>one firm.</em></h1>
        <p class="ce-lede">
          For {years} years I.S Design + Build has designed and built homes, commercial spaces and public buildings across the
          Washington area. One contract covers the drawings, the approvals and the construction.
        </p>
        <div class="ce-actions">
          <a class="ce-btn ce-btn-brass" href="#start">Request a quote</a>
          <a class="ce-btn" href="#capabilities">See what we build</a>
        </div>
      </div>
      <figure class="ce-elev">
        <svg viewBox="0 60 360 450" aria-hidden="true">
          {strokes.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} />)}
        </svg>
        <figcaption>Every project begins on paper.</figcaption>
      </figure>
      <ul class="ce-proof">
        <li><b>Est. {site.since}</b><span>{years} years building in Washington</span></li>
        <li><b>Design + build</b><span>Drawings, permits and construction in one contract</span></li>
        <li><b>EPA certified</b><span>Lead-paint abatement for older buildings</span></li>
        <li><b>Three sectors</b><span>Residential, commercial and government</span></li>
      </ul>
    </section>

    <section class="ce-firm" id="firm">
      <div class="ce-firm-text">
        <p class="ce-eyebrow">The firm</p>
        <h2 data-reveal>
          The people who draw your project are the people who build it. That is why the price holds and the details work.
        </h2>
        <p data-reveal>
          Founded in {site.since} by Italo Rodriguez and Eddie Migues, the firm has spent {years} years on Washington job sites.
          We know its rowhouses, its permit offices and its inspectors, and we take responsibility for the whole job.
        </p>
        <a class="ce-textlink" href="#firm">About the firm</a>
      </div>
      <figure class="ce-firm-media" data-reveal>
        <video autoplay muted loop playsinline preload="metadata" poster="/media/drafting-poster.jpg">
          <source src="/media/drafting.mp4" type="video/mp4" />
        </video>
        <svg class="ce-seal" viewBox="0 0 200 200" aria-hidden="true">
          <defs><path id="ce-ring" d="M100 100m-78 0a78 78 0 1 1 156 0a78 78 0 1 1-156 0"></path></defs>
          <circle cx="100" cy="100" r="98" fill="var(--ink)"></circle>
          <circle cx="100" cy="100" r="92" fill="none" stroke="var(--brass)" stroke-width="1"></circle>
          <circle cx="100" cy="100" r="62" fill="none" stroke="var(--brass)" stroke-width="1"></circle>
          <text font-size="13" letter-spacing="3.4" fill="var(--paper)"><textPath href="#ce-ring">DESIGNING + BUILDING IN WASHINGTON · SINCE 1989 ·</textPath></text>
          <text x="100" y="96" text-anchor="middle" font-family="'Newsreader Variable', Georgia, serif" font-size="40" fill="var(--paper)">{years}</text>
          <text x="100" y="118" text-anchor="middle" font-size="11" letter-spacing="3" fill="var(--brass)">YEARS</text>
        </svg>
      </figure>
    </section>

    <section class="ce-sectors" id="sectors">
      <div class="ce-section-head">
        <p class="ce-eyebrow">Who we build for</p>
        <h2>Three kinds of client. One standard of work.</h2>
      </div>
      <div class="ce-sector-grid">
        {
          sectors.map((s, i) => (
            <a class="ce-sector" href="#start" data-reveal style={`transition-delay:${i * 90}ms`}>
              <figure>
                <Image src={sectorImg[s.slug as keyof typeof sectorImg]} alt="" widths={[600, 1000]} sizes="(min-width: 900px) 31vw, 92vw" />
              </figure>
              <span>{numerals[i]}</span>
              <h3>{s.name}</h3>
              <p>{s.text}</p>
              <i>Explore {s.name.toLowerCase()} →</i>
            </a>
          ))
        }
      </div>
    </section>

    <section class="ce-caps" id="capabilities">
      <div class="ce-caps-media">
        {capImg.map((src, i) => <Image src={src} alt="" widths={[700, 1200]} sizes="(min-width: 900px) 42vw, 92vw" class={i === 0 ? 'is-on' : ''} data-cap={i} />)}
      </div>
      <div class="ce-caps-list">
        <p class="ce-eyebrow">Capabilities</p>
        <h2>Everything a building needs, under one roof.</h2>
        <ol>
          {
            capabilities.map((c, i) => (
              <li>
                <a href="#start" data-cap-link={i}>
                  <span>{numerals[i]}</span>
                  <h3>{c.name}</h3>
                  <p>{c.text}</p>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="ce-band">
      <video autoplay muted loop playsinline preload="metadata" poster="/media/plans-poster.jpg">
        <source src="/media/plans.mp4" type="video/mp4" />
      </video>
      <div class="ce-band-inner">
        <h2 data-reveal>{years} years of getting the details right.</h2>
        <ul>
          <li><b>{site.since}</b><span>Founded in Washington, DC</span></li>
          <li><b>3</b><span>Sectors served</span></li>
          <li><b>6</b><span>Disciplines in house</span></li>
          <li><b>1</b><span>Contract, start to finish</span></li>
        </ul>
      </div>
    </section>

    <section class="ce-process">
      <div class="ce-section-head">
        <p class="ce-eyebrow">How a project runs</p>
        <h2>A clear path from first conversation to final walkthrough.</h2>
      </div>
      <ol>
        {
          process.map((p, i) => (
            <li data-reveal style={`transition-delay:${i * 70}ms`}>
              <span>{numerals[i]}</span>
              <h3>{p.name}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="ce-reviews">
      <div class="ce-section-head">
        <p class="ce-eyebrow">What clients say</p>
        <h2>Trusted by Washington owners for {years} years.</h2>
      </div>
      <div class="ce-review-grid">
        {
          [0, 1, 2].map(() => (
            <blockquote data-reveal>
              <div class="ce-stars" aria-hidden="true">★★★★★</div>
              <p>A real Google review will be quoted here in full.</p>
              <footer>
                <b>Client name</b>
                <span>Placeholder · review to be supplied</span>
              </footer>
            </blockquote>
          ))
        }
      </div>
    </section>

    <section class="ce-craft">
      <figure>
        <Image src={craft} alt="A carpenter marking a board by hand" widths={[700, 1200]} sizes="(min-width: 900px) 50vw, 100vw" />
      </figure>
      <div>
        <p class="ce-eyebrow">Craft</p>
        <h2 data-reveal>Good buildings are made by hand, and by people who have done it before.</h2>
        <p data-reveal>
          Our crews handle the carpentry, tile, roofing and finishing themselves. Certified lead-safe practice is part of how we
          work in older buildings.
        </p>
        <video autoplay muted loop playsinline preload="metadata" poster="/media/chisel-poster.jpg">
          <source src="/media/chisel.mp4" type="video/mp4" />
        </video>
      </div>
    </section>

    <section class="ce-cta" id="start">
      <p class="ce-eyebrow">Request a quote</p>
      <h2 data-reveal>What are we building?</h2>
      <div class="ce-pills">
        {quoteTypes.map((q) => <a href="#start">{q}</a>)}
      </div>
      <p class="ce-cta-note">
        Choose a project type to begin, or call <a href={site.phoneHref}>{site.phone}</a>. We reply within one business day.
      </p>
    </section>

    <footer class="ce-foot">
      <div>
        <b>I.S Design + Build</b>
        <p>General contractors<br />Established {site.since}</p>
      </div>
      <div>
        <b>Office</b>
        <p>{site.address[0]}<br />{site.address[1]}</p>
      </div>
      <div>
        <b>Contact</b>
        <p><a href={site.phoneHref}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <div>
        <b>Service area</b>
        <p>Washington, DC<br />Maryland · Virginia</p>
      </div>
    </footer>
  </div>
</ConceptLayout>

<script>
  const imgs = document.querySelectorAll<HTMLElement>('.ce-caps-media [data-cap]');
  document.querySelectorAll<HTMLElement>('[data-cap-link]').forEach((link) => {
    const show = () => imgs.forEach((img) => img.classList.toggle('is-on', img.dataset.cap === link.dataset.capLink));
    link.addEventListener('mouseenter', show);
    link.addEventListener('focus', show);
  });
</script>

<style is:global>
  .ce {
    --ink: #13201b;
    --ink-2: #1c2d26;
    --paper: #f6f1e7;
    --stone: #ebe3d3;
    --brass: #b08a4f;
    --brass-lt: #d3b47e;
    --text: #23302b;
    --mute: #6c6f66;
    --line: rgba(19, 32, 27, 0.16);
    --pad: clamp(20px, 4.5vw, 76px);
    --serif: 'Newsreader Variable', Georgia, 'Times New Roman', serif;
    background: var(--paper);
    color: var(--text);
    font:
      400 17px/1.6 'Hanken Grotesk Variable',
      system-ui,
      sans-serif;
    overflow-x: clip;
  }
  .ce h1,
  .ce h2,
  .ce h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-optical-sizing: auto;
    letter-spacing: -0.018em;
    color: var(--ink);
  }
  .ce h2 {
    font-size: clamp(30px, 3.7vw, 58px);
    line-height: 1.08;
    max-width: 20ch;
  }
  .ce em {
    font-style: italic;
  }
  .ce-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .ce-eyebrow::before {
    content: '';
    width: 36px;
    height: 1px;
    background: currentColor;
  }
  .ce-btn {
    display: inline-flex;
    align-items: center;
    padding: 15px 26px;
    border: 1px solid currentColor;
    text-decoration: none;
    white-space: nowrap;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s;
  }
  .ce-btn:hover {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--ink);
  }
  .ce-btn-brass {
    background: var(--brass);
    border-color: var(--brass);
    color: #14110a;
  }
  .ce-btn-brass:hover {
    background: var(--brass-lt);
    border-color: var(--brass-lt);
  }
  .ce-textlink {
    display: inline-block;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--brass);
    color: var(--ink);
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* Header */
  .ce-head {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 30px;
    padding: 22px var(--pad);
    color: var(--paper);
    border-bottom: 1px solid rgba(246, 241, 231, 0.18);
  }
  .ce-logo {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    white-space: nowrap;
    line-height: 1.2;
  }
  .ce-logo b {
    display: block;
    font-family: var(--serif);
    font-size: 21px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .ce-logo small {
    display: block;
    margin-top: 2px;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass-lt);
  }
  .ce-head nav {
    display: flex;
    gap: 28px;
    margin-left: auto;
    font-size: 15px;
  }
  .ce-head nav a {
    text-decoration: none;
    background: linear-gradient(var(--brass-lt), var(--brass-lt)) 0 100% / 0 1px no-repeat;
    padding-bottom: 3px;
    transition: background-size 0.35s;
  }
  .ce-head nav a:hover {
    background-size: 100% 1px;
  }
  .ce-phone {
    font-family: var(--serif);
    font-size: 18px;
    text-decoration: none;
    white-space: nowrap;
  }
  .ce-head .ce-btn {
    padding: 12px 20px;
  }

  /* Hero */
  .ce-hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    color: var(--paper);
    overflow: hidden;
    background: var(--ink);
  }
  .ce-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 40%;
    animation: ce-zoom 26s ease-out forwards;
  }
  @keyframes ce-zoom {
    from {
      transform: scale(1.1);
    }
    to {
      transform: scale(1);
    }
  }
  .ce-hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(13, 22, 18, 0.93) 0%, rgba(13, 22, 18, 0.74) 38%, rgba(13, 22, 18, 0.2) 72%, rgba(13, 22, 18, 0.35) 100%),
      linear-gradient(0deg, rgba(13, 22, 18, 0.9) 0%, rgba(13, 22, 18, 0) 34%),
      linear-gradient(180deg, rgba(13, 22, 18, 0.7) 0%, rgba(13, 22, 18, 0) 22%);
  }
  .ce-hero-copy {
    position: relative;
    padding: 150px var(--pad) clamp(40px, 5vw, 72px);
    max-width: 880px;
    animation: ce-rise 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes ce-rise {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
  }
  .ce h1 {
    margin-top: 26px;
    font-size: clamp(42px, 6.3vw, 104px);
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--paper);
  }
  .ce h1 em {
    color: var(--brass-lt);
  }
  .ce-lede {
    margin-top: 28px;
    max-width: 54ch;
    font-size: clamp(16px, 1.3vw, 20px);
    color: rgba(246, 241, 231, 0.86);
  }
  .ce-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }
  .ce-elev {
    position: relative;
    align-self: center;
    margin: 90px var(--pad) 0 0;
    width: clamp(170px, 15vw, 250px);
    padding: 18px 18px 14px;
    border: 1px solid rgba(211, 180, 126, 0.55);
    background: rgba(13, 22, 18, 0.55);
    backdrop-filter: blur(8px);
  }
  .ce-elev path {
    fill: none;
    stroke: var(--brass-lt);
    stroke-width: 1.6;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: ce-draw 1.1s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    animation-delay: calc(0.9s + var(--i) * 0.2s);
  }
  @keyframes ce-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .ce-elev figcaption {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid rgba(211, 180, 126, 0.4);
    font-family: var(--serif);
    font-style: italic;
    font-size: 14px;
    line-height: 1.3;
    color: rgba(246, 241, 231, 0.85);
  }
  .ce-proof {
    position: relative;
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid rgba(246, 241, 231, 0.2);
    background: rgba(13, 22, 18, 0.6);
    backdrop-filter: blur(8px);
  }
  .ce-proof li {
    padding: 22px var(--pad) 24px;
  }
  .ce-proof li + li {
    border-left: 1px solid rgba(246, 241, 231, 0.16);
    padding-left: clamp(18px, 2vw, 32px);
  }
  .ce-proof b {
    display: block;
    font-family: var(--serif);
    font-size: clamp(19px, 1.7vw, 26px);
    font-weight: 400;
    color: var(--brass-lt);
  }
  .ce-proof span {
    display: block;
    margin-top: 2px;
    font-size: 14px;
    color: rgba(246, 241, 231, 0.75);
  }

  /* Firm */
  .ce-firm {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(36px, 6vw, 110px);
    align-items: center;
    padding: clamp(80px, 10vw, 160px) var(--pad);
  }
  .ce-firm h2 {
    margin: 26px 0 28px;
    font-size: clamp(30px, 3.6vw, 56px);
    max-width: 19ch;
  }
  .ce-firm-text > p:not(.ce-eyebrow) {
    max-width: 52ch;
    margin-bottom: 30px;
  }
  .ce-firm-media {
    position: relative;
    margin: 0;
  }
  .ce-firm-media video {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    outline: 1px solid var(--brass);
    outline-offset: 12px;
  }
  .ce-seal {
    position: absolute;
    left: -64px;
    bottom: -52px;
    width: clamp(120px, 12vw, 178px);
    animation: ce-spin 60s linear infinite;
  }
  @keyframes ce-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Sectors */
  .ce-section-head {
    display: grid;
    gap: 24px;
    margin-bottom: clamp(36px, 4vw, 64px);
  }
  .ce-sectors {
    padding: clamp(80px, 9vw, 140px) var(--pad);
    background: var(--stone);
  }
  .ce-sector-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(18px, 2.4vw, 40px);
  }
  .ce-sector {
    display: block;
    text-decoration: none;
  }
  .ce-sector figure {
    margin: 0 0 24px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .ce-sector img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .ce-sector:hover img {
    transform: scale(1.06);
  }
  .ce-sector span {
    font-family: var(--serif);
    font-style: italic;
    font-size: 17px;
    color: var(--brass);
  }
  .ce-sector h3 {
    margin: 4px 0 10px;
    font-size: clamp(30px, 3vw, 46px);
    line-height: 1.05;
  }
  .ce-sector p {
    max-width: 38ch;
    color: #45504a;
  }
  .ce-sector i {
    display: inline-block;
    margin-top: 18px;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--brass);
    font-style: normal;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }

