---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import InteriorLayout from '../../layouts/InteriorLayout.astro';
import Cta from '../../components/Cta.astro';
import articles from '../../data/articles.json';

const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/*.jpg', { eager: true });
const photo = (name: string) => photos[`../../assets/photos/${name}.jpg`].default;
---
<InteriorLayout title="Remodeling Guides for DC Homes | I.S Design + Build" description="Practical guides to planning a kitchen, bathroom or whole-home renovation in Georgetown and the wider Washington, DC area." label="Guides" headline="Ideas worth having before you start." image={photo('living-a')}>
  <Fragment slot="intro"><p>Short guides to planning a renovation in Georgetown and the wider Washington, DC area.</p></Fragment>
  <section class="guide-list">
    {articles.map((a, i) => (
      <a class="guide-card" href={`/blogs/${a.slug}/`}>
        <div class="guide-card-media"><Image src={photo(a.image)} alt="" widths={[500, 900]} sizes="(min-width: 900px) 30vw, 92vw" /></div>
        <div class="guide-card-body">
          <p class="cg-label">{String(i + 1).padStart(2, '0')} / {a.kicker}</p>
          <h2>{a.title}</h2>
          <p>{a.description}</p>
          <span class="text-link">Read the guide</span>
        </div>
      </a>
    ))}
  </section>
  <Cta />
</InteriorLayout>
