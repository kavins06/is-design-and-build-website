---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import InteriorLayout from '../../layouts/InteriorLayout.astro';
import articles from '../../data/articles.json';

const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/*.jpg', { eager: true });
const photo = (name: string) => photos[`../../assets/photos/${name}.jpg`].default;
---
<InteriorLayout title="Remodeling Guides for DC Homes | I.S Design + Build" description="Practical guides to planning a kitchen, bathroom or whole-home renovation in Georgetown and the wider Washington, DC area." label="Guides" headline="Ideas worth having before you start.">
  <Fragment slot="intro"><p>Practical guides to planning a renovation in Georgetown and the wider Washington, DC area: what to decide first, what to ask, and what to bring to a first conversation.</p></Fragment>
  <section class="guide-list">
    {articles.map((a, i) => (
      <a class="guide-card" href={`/blogs/${a.slug}/`}>
        <div class="guide-card-media"><Image src={photo(a.image)} alt="" widths={[500, 900]} sizes="(min-width: 900px) 30vw, 92vw" /></div>
        <div class="guide-card-body">
          <p class="cg-label">{String(i + 1).padStart(2, '0')} / {a.kicker}</p>
          <h2>{a.title}</h2>
          <p>{a.description}</p>
          <span class="text-link">Read the guide</span>
        </div>
      </a>
    ))}
  </section>
  <section class="page-next" data-dark><p class="cg-label">A clear way forward</p><h2>Turn an idea<br />into a plan.</h2><a class="text-link" href="/contact-us/">Tell us about your project</a><nav aria-label="Continue exploring"><a href="/our-process/">Our process</a><a href="/portfolio/">Our work</a><a href="/home-remodeling/">Remodeling</a><a href="/faqs/">FAQs</a></nav></section>
</InteriorLayout>
