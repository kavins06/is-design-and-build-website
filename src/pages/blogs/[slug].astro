---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import InteriorLayout from '../../layouts/InteriorLayout.astro';
import Cta from '../../components/Cta.astro';
import articles from '../../data/articles.json';
import { article } from '../../data/schema';

export function getStaticPaths() {
  return articles.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/*.jpg', { eager: true });
const image = photos[`../../assets/photos/${post.image}.jpg`].default;
const shared = await getImage({ src: image, width: 1200, format: 'jpg' });
const path = `/blogs/${post.slug}/`;
const published = new Date(`${post.date}T12:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const schema = [article({ title: post.title, description: post.description, date: post.date, path, image: shared.src })];
const others = articles.filter((a) => a.slug !== post.slug);
---
<InteriorLayout title={`${post.title} | I.S Design + Build`} description={post.description} label={post.kicker} headline={post.title} schema={schema} parent={{ name: 'Guides', path: '/blogs/' }} image={image} imageAlt={post.imageAlt}>
  <Fragment slot="intro"><p>{post.description}</p><p class="guide-byline">I.S Design + Build · <time datetime={post.date}>{published}</time></p></Fragment>
  {post.sections.map((section, i) => <section class="copy-section"><div class="section-index"><span class="cg-label">{String(i + 1).padStart(2, '0')} / {post.kicker}</span></div><div class="copy-body"><h2>{section.title}</h2>{section.blocks.map((block) => <Fragment set:html={block} />)}</div></section>)}
  <section class="related-services"><p class="cg-label">More guides</p>{others.map((a, i) => <a href={`/blogs/${a.slug}/`}><span>{String(i + 1).padStart(2, '0')}</span><h2>{a.title}</h2><span aria-hidden="true"></span></a>)}</section>
  <Cta service={post.service} />
</InteriorLayout>
