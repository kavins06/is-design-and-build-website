---
import geist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMono from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';

import { launched, intercomAppId } from '../data/site';
import { business, website, graph, abs } from '../data/schema';

interface Props {
  /** Extra schema.org nodes for this page, added to the site-wide graph. */
  schema?: object[];
  preloadFonts?: boolean;
  title: string;
  description?: string;
  /** Open Graph type: "article" for guides. */
  ogType?: 'website' | 'article';
  /** Keep this page out of search results and give it no canonical (the 404 page). */
  noindex?: boolean;
}

const {
  preloadFonts = false,
  schema = [],
  title,
  description = 'I.S Design + Build — a Georgetown, DC design + build firm.',
  ogType = 'website',
  noindex: hidden = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Google tag: loaded on the production site only, so preview visits are not counted.
const googleTag = process.env.VERCEL_ENV === 'production' ? 'GTM-WFP56VXL' : '';
const noindex = hidden || !launched || process.env.VERCEL_ENV !== 'production';
const jsonLd = graph([business, website, ...schema]);
const ogImage = abs('/og.jpg');

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- The drawn-then-built opening plays in full once per visit; later pages open straight onto the photograph. -->
    <script is:inline>try{var k='isdb-opened';if(sessionStorage.getItem(k))document.documentElement.classList.add('opened');else sessionStorage.setItem(k,'1')}catch(e){}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {googleTag && (
      <script is:inline define:vars={{ id: googleTag }}>
        // Google Tag Manager's standard start event, with the container itself loaded once the
        // page has finished loading so it never competes with the first screen.
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var loadTags = function () { var j = document.createElement('script'); j.async = true; j.src = 'https://www.googletagmanager.com/gtm.js?id=' + id; document.head.appendChild(j); };
        if (document.readyState === 'complete') loadTags(); else window.addEventListener('load', loadTags, { once: true });
      </script>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0c0c0c" />
    {!hidden && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {preloadFonts && <><link rel="preload" href={geist} as="font" type="font/woff2" crossorigin="anonymous" /><link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin="anonymous" /></>}
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!hidden && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="I.S Design + Build" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="I.S Design + Build: kitchens, bathrooms, whole homes and roofs in the Washington, DC area since 1989." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
    <slot name="head" />
  </head>
  <body>
    {googleTag && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${googleTag}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>}
    <slot />
    <script is:inline>
      // Lead signals for analytics: calls and emails, with where on the page they came from.
      // Chat buttons are counted by the chat script below.
      document.addEventListener('click', function (event) {
        var link = event.target instanceof Element ? event.target.closest('a') : null;
        if (!link) return;
        var href = link.getAttribute('href') || '';
        var dl = (window.dataLayer = window.dataLayer || []);
        var where = link.closest('[data-m-bar]') ? 'phone_bar' : link.closest('header') ? 'header' : link.closest('footer') ? 'footer' : link.closest('#contact') ? 'closing' : 'page';
        if (href.indexOf('tel:') === 0) dl.push({ event: 'click_to_call', link_location: where });
        else if (href.indexOf('mailto:') === 0) dl.push({ event: 'email_click', link_location: where });
      }, { capture: true });
    </script>
    {intercomAppId && (
      <script is:inline define:vars={{ intercomAppId }}>
        // Intercom Messenger, where Tony (Fin AI) answers first and takes the visitor's details.
        // Uses Intercom's standard install snippet. The widget is about 1 MB and ties up a phone for
        // up to a second while it starts, so it is fetched only when a visitor taps Chat now, or, for
        // someone who already has a conversation open, once the page has loaded and the browser is
        // idle. Intercom's own launcher is hidden: the Chat now buttons open it.
        //
        // Every Chat now button is a link to the contact page marked data-chat. If the chat script is
        // blocked or does not open within a few seconds, the visitor is taken to that link (on the
        // contact page itself, a note appears), so a tap never ends in nothing.
        window.intercomSettings = { api_base: 'https://api-iam.intercom.io', app_id: intercomAppId, hide_default_launcher: true };
        (function () {
          var w = window; var d = document; var ic = w.Intercom;
          if (typeof ic === 'function') { ic('reattach_activator'); ic('update', w.intercomSettings); return; }
          var i = function () { i.c(arguments); }; i.q = []; i.c = function (args) { i.q.push(args); }; w.Intercom = i;
          var loaded = false; var failed = false; var shown = false; var pending = null; var lastService = '';
          var fallback = function () {
            if (!pending || shown) return;
            var link = pending; pending = null;
            (w.dataLayer = w.dataLayer || []).push({ event: 'chat_unavailable', service: link.getAttribute('data-service') || 'none' });
            var note = d.querySelector('[data-chat-failed]');
            if (note) { note.hidden = false; note.focus(); } else w.location.href = link.href;
          };
          var l = function () {
            if (loaded) return; loaded = true;
            var s = d.createElement('script'); s.type = 'text/javascript'; s.async = true; s.src = 'https://widget.intercom.io/widget/' + intercomAppId;
            s.onerror = function () { failed = true; fallback(); };
            d.head.appendChild(s);
          };
          w.Intercom('onShow', function () { shown = true; pending = null; });
          w.Intercom('onHide', function () { shown = false; });
          // A lead: the visitor gave Tony an email address in the chat.
          w.Intercom('onUserEmailSupplied', function () { (w.dataLayer = w.dataLayer || []).push({ event: 'generate_lead', link_location: 'chat', service: lastService || 'none' }); });
          d.addEventListener('click', function (event) {
            var link = event.target instanceof Element ? event.target.closest('a[data-chat]') : null;
            if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.button) return;
            // Links without their own service (header, footer) take the service of the page they are on.
            var pages = { '/kitchen-remodeling/': 'kitchen', '/bathroom-remodeling/': 'bathroom', '/whole-home-remodeling/': 'whole-home', '/home-additions/': 'addition', '/roofing/': 'roofing', '/home-remodeling/': 'remodeling', '/lead-paint-abatement/': 'lead' };
            var service = link.getAttribute('data-service') || pages[location.pathname] || '';
            var where = link.closest('[data-m-bar]') ? 'phone_bar' : link.closest('header') ? 'header' : link.closest('footer') ? 'footer' : link.closest('#contact') ? 'closing' : 'page';
            (w.dataLayer = w.dataLayer || []).push({ event: 'chat_open', link_location: where, service: service || 'none' });
            event.preventDefault();
            if (failed) { pending = link; fallback(); return; }
            // Tony sees which service the visitor was reading about.
            if (service) { lastService = service; w.Intercom('update', { service_interest: service }); }
            pending = link; l(); w.Intercom('show');
            setTimeout(fallback, 8000);
          });
          if (d.cookie.indexOf('intercom-session-' + intercomAppId + '=') !== -1) {
            var later = function () { if ('requestIdleCallback' in w) w.requestIdleCallback(l, { timeout: 3000 }); else setTimeout(l, 1); };
            if (d.readyState === 'complete') later(); else w.addEventListener('load', later, { once: true });
          }
        })();
      </script>
    )}
  </body>
</html>
