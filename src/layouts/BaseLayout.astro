---
import geist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMono from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';

import { business, website, graph, abs } from '../data/schema';

interface Props {
  /** Extra schema.org nodes for this page, added to the site-wide graph. */
  schema?: object[];
  preloadFonts?: boolean;
  title: string;
  description?: string;
}

const {
  preloadFonts = false,
  schema = [],
  title,
  description = 'I.S Design + Build — a Georgetown, DC design + build firm.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const noindex = process.env.VERCEL_ENV !== 'production' || Astro.url.pathname.startsWith('/concepts/');
const jsonLd = graph([business, website, ...schema]);
const ogImage = abs('/og.jpg');

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {preloadFonts && <><link rel="preload" href={geist} as="font" type="font/woff2" crossorigin="anonymous" /><link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin="anonymous" /></>}
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="I.S Design + Build" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="I.S Design + Build. Homes designed and built in the Washington, DC area since 1989." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
