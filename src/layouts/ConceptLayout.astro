---
interface Props {
  title: string;
  current: 'a' | 'b' | 'c' | 'd';
}
const { title, current } = Astro.props;
const tabs = [
  { id: 'a', label: 'A · Monolith' },
  { id: 'b', label: 'B · Atelier' },
  { id: 'c', label: 'C · Drawing Set' },
  { id: 'd', label: 'D · C + A' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <nav class="concept-switch" aria-label="Design directions">
      <span>Direction</span>
      {tabs.map((t) => (
        <a href={`/concepts/${t.id}/`} aria-current={t.id === current ? 'page' : undefined}>{t.label}</a>
      ))}
    </nav>
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  a {
    color: inherit;
  }
  h1,
  h2,
  h3,
  p,
  ul,
  ol {
    margin: 0;
    padding: 0;
  }
  ul,
  ol {
    list-style: none;
  }
  [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.9s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  [data-reveal].is-in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
    }
    [data-reveal] {
      opacity: 1;
      transform: none;
    }
    html {
      scroll-behavior: auto;
    }
  }
  .concept-switch {
    position: fixed;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 5px;
    border-radius: 999px;
    background: rgba(17, 17, 17, 0.92);
    color: #fff;
    font:
      500 12px/1 system-ui,
      sans-serif;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
    white-space: nowrap;
  }
  .concept-switch span {
    padding: 0 8px 0 12px;
    opacity: 0.55;
  }
  .concept-switch a {
    padding: 9px 12px;
    border-radius: 999px;
    text-decoration: none;
  }
  .concept-switch a[aria-current='page'] {
    background: #fff;
    color: #111;
  }
  @media (max-width: 560px) {
    .concept-switch span {
      display: none;
    }
    .concept-switch a {
      padding: 9px 10px;
      font-size: 11px;
    }
  }
</style>
