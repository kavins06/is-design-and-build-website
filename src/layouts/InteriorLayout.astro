---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/hero.css';
import '../styles/home.css';
import '../styles/content.css';
import '../styles/interior.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { breadcrumbs } from '../data/schema';
interface Props { title: string; description: string; label: string; headline: string; schema?: object[]; parent?: { name: string; path: string }; image?: ImageMetadata; imageAlt?: string; compact?: boolean; }
const { title, description, label, headline, schema = [], parent, image, imageAlt = '', compact = false } = Astro.props;
const crumbs = breadcrumbs([{ name: 'Home', path: '/' }, ...(parent ? [parent] : []), { name: label, path: Astro.url.pathname }]);
---
<BaseLayout preloadFonts title={title} description={description} schema={[crumbs, ...schema]}>
  <div class="cg interior"><Header overlay /><main id="main">
    <section class:list={['page-hero', { 'has-photo': image, 'is-compact': compact || !image }]} data-dark>
      {image && <Image src={image} alt={imageAlt} widths={[900, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" class="page-hero-photo" />}
      <div class="page-hero-grid" aria-hidden="true"></div>
      <div class="page-hero-copy">
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span>{parent && <><a href={parent.path}>{parent.name}</a><span aria-hidden="true">/</span></>}<span aria-current="page">{label}</span></nav>
        <h1>{headline}</h1>
        <div class="page-intro"><slot name="intro" /></div>
      </div>
    </section>
    <slot />
  </main><Footer /></div>
</BaseLayout>
<script>
  // Reveal sections as they enter the viewport. Content is visible without script.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('reveal-ready');
    const io = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -12% 0px' });
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
  }
</script>
