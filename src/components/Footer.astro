---
import { site, credentials, chatHref, serviceByPath } from '../data/site';
const serviceLinks = [['Remodeling', '/home-remodeling/'], ['Kitchens', '/kitchen-remodeling/'], ['Bathrooms', '/bathroom-remodeling/'], ['Whole-home', '/whole-home-remodeling/'], ['Additions', '/home-additions/'], ['Roofing', '/roofing/'], ['Lead paint', '/lead-paint-abatement/']];
const companyLinks = [['Our work', '/portfolio/'], ['Reviews', '/reviews/'], ['About us', '/about-us/'], ['Our process', '/our-process/'], ['Service areas', '/service-areas/'], ['Financing', '/financing/'], ['FAQs', '/faqs/'], ['Guides', '/blogs/'], ['Contact', '/contact-us/']];
const path = Astro.url.pathname;
const bar = !path.startsWith('/contact-us');
// The phone bar opens the chat for the service the visitor is reading about.
const service = serviceByPath[path];
---
<footer class="site-footer" data-dark>
  <div class="footer-top"><a class="footer-brand" href="/" aria-label="I.S Design + Build, home">I.S Design <span>+</span> Build</a><p>Kitchens, bathrooms, whole homes, additions, roofs and lead paint.<br />In business in the DC area since 1989. Formerly I.S. Enterprises.</p></div>
  <div class="footer-columns"><div class="footer-links"><nav aria-labelledby="footer-services"><p class="footer-head" id="footer-services">Services</p>{serviceLinks.map(([label,href]) => <a href={href}>{label}</a>)}</nav><nav aria-labelledby="footer-company"><p class="footer-head" id="footer-company">Company</p>{companyLinks.map(([label,href]) => <a href={href}>{label}</a>)}</nav></div><div><a href={site.phoneHref}>{site.phone}</a><a href={`mailto:${site.email}`}>{site.email}</a><a class="text-link" href={chatHref()} data-chat>Chat now</a></div><address>{site.address[0]}<br />{site.address[1]}<br />{site.hours}</address></div>
  {credentials && <p class="footer-legal">{credentials}</p>}
  <div class="footer-bottom"><p>© {new Date().getFullYear()} {site.name}.</p><nav aria-label="Legal"><a href="/privacy-policy/">Privacy Policy</a><a href="/terms-of-service/">Terms of Service</a></nav></div>
</footer>
{bar && (
  <nav class="m-bar has-number" data-m-bar aria-label="Quick contact">
    <a href={site.phoneHref}>Call {site.phone}</a><a class="is-primary" href={chatHref(service)} data-chat data-service={service}>Chat now</a>
  </nav>
)}
<script>
  const bar = document.querySelector<HTMLElement>('[data-m-bar]');
  if (bar) {
    const update = () => bar.classList.toggle('is-on', window.scrollY > 160);
    update(); window.addEventListener('scroll', update, { passive: true });
  }
</script>
