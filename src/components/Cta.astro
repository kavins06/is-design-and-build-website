---
import { site, chatHref } from '../data/site';
interface Props {
  /** The closing question, as two lines. The second line is set in orange. */
  lines?: [string, string];
  service?: string;
  /** Lead with the phone number, for work that cannot wait (roofing). */
  phone?: boolean;
}
const { lines = ['What would you', 'like to change?'], service, phone = false } = Astro.props;
const chat = chatHref(service);
---
<section class="ct" id="contact" data-dark>
  <p class="cg-label">Talk to us</p>
  <h2 class="ct-title"><span>{lines[0]}</span><span>{lines[1]}</span></h2>
  <div class="ct-actions">
    {phone
      ? <><a class="btn" href={site.phoneHref}>Call {site.phone}</a><a class="text-link" href={chat} data-chat data-service={service}>Chat now</a></>
      : <><a class="btn" href={chat} data-chat data-service={service}>Chat now</a><a class="text-link" href={site.phoneHref}>Call {site.phone}</a></>}
  </div>
  <div class="ct-grid"><div><span>Call</span><a href={site.phoneHref}>{site.phone}</a></div><div><span>Chat</span><a href={chat} data-chat data-service={service}>Any time, day or night</a></div><div><span>Email</span><a href={`mailto:${site.email}`}>{site.email}</a></div><div><span>Where we work</span><a href="/service-areas/">DC · Maryland · Northern Virginia</a></div></div>
</section>
