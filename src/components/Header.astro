---
const { home = false, overlay = false } = Astro.props;
import { site } from '../data/site';
const services = [['Remodeling overview', '/home-remodeling/'], ['Kitchens', '/kitchen-remodeling/'], ['Bathrooms', '/bathroom-remodeling/'], ['Whole-home renovations', '/whole-home-remodeling/'], ['Home additions', '/home-additions/'], ['Lead paint', '/lead-paint-abatement/']];
const about = [['Our story', '/about-us/'], ['Our process', '/our-process/'], ['Service areas', '/service-areas/'], ['Financing', '/financing/'], ['FAQs', '/faqs/'], ['Guides', '/blogs/']];
---
<a class="skip-link" href="#main">Skip to content</a>
<header class:list={['hd', { 'is-solid': !home && !overlay }]} data-home={home || overlay}>
  <a class="hd-logo" href="/" aria-label="I.S Design + Build, home">I.S Design <span>+</span> Build</a>
  <button class="menu-toggle" aria-expanded="false" aria-controls="primary-nav">Menu <span aria-hidden="true">+</span></button>
  <nav id="primary-nav" aria-label="Primary">
    <details class="nav-group"><summary>Services</summary><div class="nav-dropdown">{services.map(([label, href]) => <a href={href}>{label}</a>)}</div></details>
    <a href="/roofing/">Roofing</a>
    <a href="/portfolio/">Our work</a>
    <a href="/reviews/">Reviews</a>
    <details class="nav-group"><summary>About</summary><div class="nav-dropdown">{about.map(([label, href]) => <a href={href}>{label}</a>)}</div></details>
    <a class="mobile-phone" href={site.phoneHref}>{site.phone}</a>
  </nav>
  <a class="hd-phone" href={site.phoneHref}>{site.phone}</a>
  <a class="hd-cta" href="/contact-us/">Start a project</a>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.hd');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  header?.classList.add('nav-ready');
  // While the phone menu is open, the page behind it is inert, so focus cannot wander there.
  const behind = () => [document.querySelector('main'), document.querySelector('.site-footer')].filter((el): el is HTMLElement => !!el);
  const setMenu = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('menu-open', open);
    document.documentElement.classList.toggle('menu-locked', open);
    behind().forEach((el) => { el.inert = open; });
    // The phone menu shows every link at once; the desktop dropdowns start closed.
    document.querySelectorAll<HTMLDetailsElement>('.nav-group').forEach(group => { group.open = open; });
  };
  const closeMenu = () => { if (header?.classList.contains('menu-open')) setMenu(false); };
  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  // Following a link, coming back to the page, or widening the window past the phone layout closes it.
  header?.querySelector('nav')?.addEventListener('click', (event) => { if (event.target instanceof Element && event.target.closest('a')) closeMenu(); });
  window.addEventListener('pageshow', closeMenu);
  window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => { if (event.matches) closeMenu(); });
  // Desktop dropdowns close once keyboard focus moves out of them.
  document.querySelectorAll<HTMLDetailsElement>('.nav-group').forEach((group) => group.addEventListener('focusout', (event) => {
    if (header?.classList.contains('menu-open')) return;
    if (!(event.relatedTarget instanceof Node) || !group.contains(event.relatedTarget)) group.open = false;
  }));
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('.nav-group[open]').forEach(group => { group.open = false; group.querySelector('summary')?.focus(); });
    if (header?.classList.contains('menu-open')) { closeMenu(); toggle?.focus(); }
  });
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    const target = event.target;
    if (!header?.classList.contains('menu-open')) document.querySelectorAll<HTMLDetailsElement>('.nav-group[open]').forEach(group => { if (!group.contains(target)) group.open = false; });
    if (!header?.contains(target)) closeMenu();
  });
  // Over a page-top photograph the header is transparent; once the page moves, it gets a
  // dark backing so it never sits on top of the headline or the buttons.
  if (header) {
    const veil = () => header.classList.toggle('is-veiled', window.scrollY > 24);
    veil(); window.addEventListener('scroll', veil, { passive: true });
  }
  // Also usable without GSAP and when reduced motion is requested.
  if (header?.dataset.home === 'true') {
    const hero = document.querySelector('.cg-hero, .page-hero');
    if (hero) new IntersectionObserver(([entry]) => header.classList.toggle('is-solid', !entry.isIntersecting), { rootMargin: '-72px 0px 0px' }).observe(hero);
  }
</script>
