---
import { Image } from 'astro:assets';
import { photos, galleries } from '../../data/photos';
// Completed work as a sideways gallery driven by vertical scroll. Phones swipe it.
interface Props { label?: string; title?: string; gallery: string }
const { label = 'From our completed work', title = 'From our completed projects.', gallery } = Astro.props;
const shots = (galleries[gallery] ?? galleries.kitchen).map((key) => photos[key]);
---
<section class="rail" data-scene="rail">
  <div class="rail-pin">
    <div class="rail-head">
      <p class="cg-label">{label}</p>
      <a class="text-link" href="/portfolio/">View our projects</a>
    </div>
    <div class="rail-track">
      <h2 class="rail-title">{title}</h2>
      {shots.map((p, i) => (
        <figure class:list={{ 'is-tall': p.tall }}>
          <div><Image src={p.src} alt={p.alt} widths={[700, 1200, 1600]} sizes="(min-width: 900px) 56vw, 80vw" loading="lazy" /></div>
          <figcaption><span>{String(i + 1).padStart(2, '0')}</span>{p.room}</figcaption>
        </figure>
      ))}
    </div>
    <div class="rail-foot" aria-hidden="true"><span class="rail-hint">Keep scrolling</span><div class="rail-progress"><i></i></div></div>
  </div>
</section>
