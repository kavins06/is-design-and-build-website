---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
// One statement over a photograph that opens from a framed inset to full bleed.
interface Props { label: string; title: string; text: string[]; image: ImageMetadata; alt: string; stock?: boolean; link?: { href: string; text: string } }
const { label, title, text, image, alt, stock = false, link } = Astro.props;
const external = (href: string) => /^https?:/.test(href);
---
<section class="bnd" data-scene="band" data-dark>
  <div class="bnd-frame">
    <Image src={image} alt={alt} widths={[900, 1600, 2400]} sizes="100vw" loading="lazy" />
    {stock && <span class="media-note bnd-note">Design reference</span>}
    <div class="bnd-copy">
      <p class="cg-label">{label}</p>
      <h2>{title}</h2>
      {text.map((t) => <p>{t}</p>)}
      {link && <a class="text-link" href={link.href} rel={external(link.href) ? 'noopener' : undefined}>{link.text}</a>}
    </div>
  </div>
</section>
