---
import { drawings } from '../../data/drawings';
// A pinned drawing sheet: each point on the page draws its own part of the drawing.
// Without motion every point is open and the drawing is complete.
interface Item { name: string; text: string; href?: string; cta?: string }
interface Props { label: string; title: string; items: Item[]; drawing: string; note?: string }
const { label, title, items, drawing, note } = Astro.props;
const dw = drawings[drawing];
const external = (href: string) => /^https?:/.test(href);
---
<section class="dw" data-dark data-scene="plan">
  <div class="dw-pin">
    <div class="dw-side">
      <div class="dw-head"><p class="cg-label">{label}</p><h2 data-split>{title}</h2></div>
      <ol class="dw-steps">
        {items.map((it, i) => (
          <li class={i === 0 ? 'is-on' : undefined}>
            <span>{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{it.name}</h3>
              <div class="dw-text"><div><p>{it.text}</p>{it.href && <a class="text-link" href={it.href} rel={external(it.href) ? 'noopener' : undefined}>{it.cta}</a>}</div></div>
            </div>
          </li>
        ))}
      </ol>
      <div class="dw-progress" aria-hidden="true"><i></i></div>
    </div>
    <figure class="dw-sheet">
      <svg viewBox="0 0 800 520" role="img" aria-label={dw.alt}>
        {dw.defs && <defs set:html={dw.defs} />}
        <g class="dw-base" set:html={dw.base} />
        {dw.parts.map((part) => <g class="dw-part" set:html={part} />)}
      </svg>
      <figcaption><span>{dw.name} · Illustrative</span><span class="dw-stage" aria-hidden="true">{items[0].name}</span></figcaption>
    </figure>
  </div>
  {note && <p class="dw-note">{note}</p>}
</section>
