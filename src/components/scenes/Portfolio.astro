---
import { Image, getImage } from 'astro:assets';
import { photos, portfolio } from '../../data/photos';
// Completed work: the strongest photograph full width, then the rest grouped by room in two
// large columns. Each opens full screen; without JavaScript the link opens the large image itself.
const keys = [portfolio.lead, ...portfolio.groups.flatMap((g) => g.keys)];
const large = Object.fromEntries(
  await Promise.all(keys.map(async (key) => [key, (await getImage({ src: photos[key].src, width: 2000, format: 'webp' })).src])),
);
const index = (key: string) => keys.indexOf(key);
const lead = photos[portfolio.lead];
const viewer = keys.map((key) => ({ src: large[key], alt: photos[key].alt, room: photos[key].room }));
---
<section class="pf" data-scene="portfolio">
  <figure class="pf-lead">
    <a href={large[portfolio.lead]} data-view={index(portfolio.lead)}><Image src={lead.src} alt={lead.alt} widths={[800, 1400, 2000, 2560]} sizes="(min-width: 900px) calc(100vw - 112px), 100vw" loading="eager" fetchpriority="high" /></a>
    <figcaption>{lead.room}<span>{keys.length} photographs from our completed projects</span></figcaption>
  </figure>
  {portfolio.groups.map((group) => (
    <div class="pf-group">
      <h2 data-split>{group.title}</h2>
      <div class="pf-grid">
        {group.keys.map((key) => (
          <figure>
            <a href={large[key]} data-view={index(key)}><Image src={photos[key].src} alt={photos[key].alt} widths={[600, 1000, 1400, 2000]} sizes="(min-width: 701px) 48vw, 100vw" loading="lazy" /></a>
          </figure>
        ))}
      </div>
    </div>
  ))}
  <dialog class="lb" aria-label="Project photographs">
    <div class="lb-stage"><img alt="" /></div>
    <p class="lb-meta"><span class="lb-count"></span><span class="lb-room"></span></p>
    <button class="lb-close" type="button">Close</button>
    <button class="lb-prev" type="button" aria-label="Previous photograph"></button>
    <button class="lb-next" type="button" aria-label="Next photograph"></button>
  </dialog>
  <script type="application/json" data-viewer set:html={JSON.stringify(viewer)} />
</section>
<script>
  // Full-screen viewer: arrow keys, buttons and swipes move through the photographs.
  const dialog = document.querySelector<HTMLDialogElement>('.lb');
  const data = JSON.parse(document.querySelector('[data-viewer]')?.textContent || '[]') as { src: string; alt: string; room: string }[];
  if (dialog && data.length && typeof dialog.showModal === 'function') {
    const img = dialog.querySelector('img')!;
    const count = dialog.querySelector('.lb-count')!;
    const room = dialog.querySelector('.lb-room')!;
    const pad = (n: number) => String(n).padStart(2, '0');
    let index = 0;
    const show = (i: number) => {
      index = (i + data.length) % data.length;
      img.classList.remove('is-in');
      img.src = data[index].src;
      img.alt = data[index].alt;
      count.textContent = `${pad(index + 1)} / ${pad(data.length)}`;
      room.textContent = data[index].room;
      // Warm the neighbours so stepping through feels instant.
      [index + 1, index - 1].forEach((n) => { new Image().src = data[(n + data.length) % data.length].src; });
    };
    img.addEventListener('load', () => img.classList.add('is-in'));
    document.querySelectorAll<HTMLAnchorElement>('[data-view]').forEach((link) => link.addEventListener('click', (event) => {
      event.preventDefault();
      show(Number(link.dataset.view));
      dialog.showModal();
      document.documentElement.classList.add('lb-open');
    }));
    dialog.addEventListener('close', () => document.documentElement.classList.remove('lb-open'));
    dialog.querySelector('.lb-close')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lb-prev')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('.lb-next')?.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });
    // A click on the dark surround closes the viewer.
    dialog.addEventListener('click', (event) => { if (event.target === dialog || (event.target as Element).classList.contains('lb-stage')) dialog.close(); });
    // Sideways swipes move through the photographs; the dialog leaves vertical panning and
    // pinch-zoom to the browser (touch-action in scenes.css), so horizontal moves arrive here.
    let startX: number | null = null;
    dialog.addEventListener('pointerdown', (event) => { startX = event.clientX; });
    dialog.addEventListener('pointercancel', () => { startX = null; });
    dialog.addEventListener('pointerup', (event) => {
      if (startX === null) return;
      const dx = event.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 50 && event.pointerType !== 'mouse') show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>
