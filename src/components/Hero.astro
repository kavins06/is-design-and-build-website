---
import { Image } from 'astro:assets';
import { site, chatHref } from '../data/site';
import photo from '../assets/photos/kitchen-a.jpg';

// The hero kitchen is one of our own projects. Its drawing is traced by hand in the
// photograph's own 2560 x 1707 coordinate space, so the lines land on the room when
// the photograph is built under them.
const box = (x1: number, y1: number, x2: number, y2: number) => `M${x1} ${y1}H${x2}V${y2}H${x1}z`;
const pendant = (x: number, top: number, cap: number, w1: number, w2: number, bottom: number) => {
  const neck = cap + Math.round((bottom - cap) * 0.3);
  return `M${x} ${top}V${cap}M${x - w1} ${cap}h${2 * w1}l4 ${neck - cap}h${-2 * w1 - 8}zM${x - w1 - 4} ${neck}L${x - w2} ${bottom}H${x + w2}L${x + w1 + 4} ${neck}`;
};
const strokes = [
  'M0 1043L495 1016M823 993L1448 945',
  box(59, 330, 450, 815) + 'M267 330V815',
  'M450 408L799 483M450 408V990',
  'M587 453H676V623M587 453V623M587 623L476 696L799 716L676 623M478 708L799 728',
  'M784 483L1138 516V835L784 833zM913 495V834M1015 505V834',
  'M1163 706L1384 718M1147 797L1352 806',
  box(495, 980, 823, 1377) + 'M503 1059H815M503 1269H815' + box(565, 1102, 759, 1205),
  'M16 1043V1479L495 1377M16 1081L495 1067M16 1237L495 1210M240 1103H335M240 1240H335',
  box(1452, 742, 1592, 976) + 'M1522 742V976',
  'M865 1033L1100 1100V1707M865 1033V1475L1055 1707',
  'M865 1033L1860 955L1890 985L1100 1100M1100 1124L1890 1006',
  pendant(1224, 151, 532, 14, 57, 662),
  pendant(1496, 293, 600, 12, 45, 706),
  pendant(1681, 394, 645, 11, 40, 731),
  box(1901, 667, 2217, 942) + 'M2066 667V942M1901 830H2217',
  box(2311, 710, 2498, 878),
  'M1886 956L2414 976M1890 978L2414 996M2352 996V1184M2386 996V1184M2135 555V729M2040 752H2232',
  'M1315 1060Q1400 1035 1483 1032L1480 1185M1315 1060Q1190 1150 1150 1205L1255 1250L1480 1190M1145 1210L1105 1625M1255 1250L1280 1707M1450 1192L1490 1590M1480 1186L1515 1600',
  'M1505 1020Q1580 1003 1650 1005L1650 1160M1505 1020Q1470 1110 1460 1170L1515 1200L1650 1160M1465 1180L1490 1600M1515 1200L1520 1605M1640 1152L1660 1500M1650 1160L1690 1480',
  'M1645 1050Q1720 1000 1800 990L1790 1105M1645 1050Q1630 1100 1635 1120L1790 1105M1640 1120L1650 1490M1790 1110L1800 1400',
  'M1780 980Q1835 968 1890 970L1885 1085M1790 1100L1800 1350M1880 1090L1900 1330',
  'M1870 965Q1920 955 1970 955L1965 1068M1880 1080L1900 1280M1965 1070L1975 1290',
];
const dims = ['M1910 985V1265M1894 985h32M1894 1265h32'];
---

<section class="cg-hero">
  <div class="cg-stage">
    <Image src={photo} alt="Kitchen from one of our projects, with walnut base cabinets, a marble backsplash and a waterfall island with stools" widths={[640, 1080, 1600, 2400]} sizes="100vw" quality={70} loading="eager" fetchpriority="high" class="cg-photo" />
    <div class="cg-hero-shade"></div>
    <svg class="cg-elev" viewBox="0 0 2560 1707" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g class="cg-strokes">{strokes.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} />)}</g>
      <g class="cg-dims">
        {dims.map((d) => <path d={d} pathLength="1" style={`--i:${strokes.length}`} />)}
        <text x="1936" y="1138" text-anchor="start" style={`--i:${strokes.length + 1}`}>3'-0"</text>
      </g>
    </svg>
  </div>
  <div class="cg-hero-copy">
    <p class="hero-eyebrow">Washington, DC area · Since 1989</p>
    <h1>
      <span>Your home.</span>{' '}
      <span>In good</span>{' '}
      <span class="is-built">hands.</span>
    </h1>
    <p>Kitchens, bathrooms, additions and whole homes, designed, permitted and built by one firm, plus roofs and lead-safe work. Founded by Italo Rodriguez and Eddie Migues.</p><div class="hero-actions"><a class="btn" href={chatHref()} data-chat>Chat now</a><a class="text-link" href="/portfolio/">See our work</a></div><p class="hero-urgent">Roof leak? <a href={site.phoneHref}>Call {site.phone}</a></p>
  </div>
  <p class="cg-titleblock"><span class="cg-status">Our project</span></p>
</section>
