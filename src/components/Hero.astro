---
import { Image } from 'astro:assets';
import photo from '../assets/stock/kit-08.jpg';

// Elevation of the hero kitchen, traced in the photo's own 2400 x 1450 coordinate space
// so the drawing lines up with the room once the photo is revealed.
const box = (x1: number, y1: number, x2: number, y2: number) => `M${x1} ${y1}H${x2}V${y2}H${x1}z`;
const stool = (x: number) =>
  `M${x} 800q145 -22 290 0l-30 150q-115 40 -230 0zM${x + 45} 975L${x - 10} 1420M${x + 235} 975L${x + 295} 1420M${x + 22} 1175H${x + 265}`;
const pendant = (x: number, y: number) => `M${x} 0V${y}M${x} ${y}q-12 70 -56 112q56 46 112 0q-44 -42 -56 -112`;
const strokes = [
  'M20 1195H740M1640 1195H2090',
  box(25, 105, 375, 1195) + 'M25 288H375M25 195H375M113 105V288M200 105V288M288 105V288',
  box(400, 105, 810, 820) + 'M400 288H810M400 462H810M400 640H810M604 105V288',
  box(400, 830, 740, 1195) + 'M604 830V1195',
  box(835, 85, 2085, 225) + 'M1150 85V225M1470 85V225M1780 85V225',
  box(840, 230, 1780, 540) + 'M1150 230V540M1455 230V540',
  box(840, 545, 1780, 770),
  box(1785, 230, 2085, 555),
  box(1800, 565, 2075, 700) + box(1800, 720, 2075, 960),
  box(1795, 985, 2080, 1195),
  box(730, 770, 1640, 792) + 'M740 792V1340H1640V792',
  'M1180 770V520q0 -30 -22 -30',
  stool(860),
  stool(1215),
  pendant(1345, 240),
  pendant(1535, 300),
];
const dims = ['M690 792V1340M674 792h32M674 1340h32'];
---

<section class="cg-hero">
  <div class="cg-stage">
    <Image src={photo} alt={"Kitchen with walnut and matte black cabinetry, an island and two stools"} widths={[900, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" class="cg-photo" />
    <div class="cg-hero-shade"></div>
    <svg class="cg-elev" viewBox="0 0 2400 1450" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g class="cg-strokes">{strokes.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} />)}</g>
      <g class="cg-dims">
        {dims.map((d) => <path d={d} pathLength="1" style={`--i:${strokes.length}`} />)}
        <text x="664" y="1076" text-anchor="end" style={`--i:${strokes.length + 1}`}>3'-0"</text>
      </g>
    </svg>
  </div>
  <div class="cg-hero-copy">
    <p class="hero-eyebrow">Home remodeling & roofing · In-house team</p>
    <h1>
      <span>Your home.</span>
      <span>In good</span>
      <span class="is-built">hands.</span>
    </h1>
    <p>Kitchens, bathrooms, additions and whole homes, designed and built by one team. Roofing too.</p><p class="hero-area">Washington, DC · Northern Virginia · Montgomery County, Maryland</p><div class="hero-actions"><a class="btn" href="/contact-us/">Start a project</a><a class="text-link" href="/portfolio/">Explore our work</a></div>
  </div>
  <dl class="cg-titleblock">
    <div><dt>Drawing</dt><dd>Kitchen elevation</dd></div>
    <div><dt>Scale</dt><dd>1/4" = 1'-0"</dd></div>
    <div><dt>Image</dt><dd class="cg-status">Design reference</dd></div>
  </dl>
</section>
